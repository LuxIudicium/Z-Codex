    <sys:String x:Key="S.GwRank.SyncDone" xml:space="preserve">GWRank is up to date.&#10;&#10;Yours: {0} build(s), {1} teambuild(s).&#10;Public: {2} build(s), {3} teambuild(s).</sys:String>
