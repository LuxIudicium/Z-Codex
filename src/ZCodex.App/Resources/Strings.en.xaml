    <!-- Collision d'identité : deux fichiers portent le même id (copie dans l'explorateur).
         Le libellé doit nommer les DEUX fichiers, sinon l'utilisateur ne peut pas comprendre. -->
    <sys:String x:Key="S.GwRank.CollisionTitle">Duplicate build identity</sys:String>
    <sys:String x:Key="S.GwRank.CollisionBody" xml:space="preserve">This build shares its internal identity with another file already sent to GWRank:&#10;&#10;    {0}&#10;&#10;This happens when a build file is duplicated outside Z-Codex. Sending it as is would overwrite the other build on GWRank.&#10;&#10;Z-Codex can give this build a new identity and send it separately. Your skills, attributes, variants and locks are unchanged.&#10;&#10;Give it a new identity and send?</sys:String>
    <sys:String x:Key="S.GwRank.CollisionFixed">A new identity was assigned and the file was saved.</sys:String>
    <sys:String x:Key="S.GwRank.CollisionUnsaved">A new identity was assigned. Save this build to keep it.</sys:String>

