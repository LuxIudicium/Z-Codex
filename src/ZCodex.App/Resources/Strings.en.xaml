    <sys:String x:Key="S.GwRank.CopyTitle">Build from GWRank</sys:String>
    <sys:String x:Key="S.GwRank.CopyBody" xml:space="preserve">This build comes from GWRank and lives in a view that the next refresh will rebuild — saving over it would lose your changes.&#10;&#10;Z-Codex will save it as a copy of your own, with a fresh identity, in the folder you choose.</sys:String>
