    <sys:String x:Key="S.Tb.GwRankSend">Send to GWRank</sys:String>
    <sys:String x:Key="S.GwRank.OnboardTitle">Connect Z-Codex to your GWRank account</sys:String>
    <sys:String x:Key="S.GwRank.OnboardIntro">Z-Codex can send your builds to your GWRank library. It needs a personal API key, which you create on GWRank itself — it takes a minute.</sys:String>
    <sys:String x:Key="S.GwRank.OnboardStep1">1. Open gwrank.com and sign in.</sys:String>
    <sys:String x:Key="S.GwRank.OnboardStep2">2. Go to your profile page and create an API key.</sys:String>
    <sys:String x:Key="S.GwRank.OnboardStep3">3. Copy the key, then paste it in the field below.</sys:String>
    <sys:String x:Key="S.GwRank.OnboardOpenSite">Open gwrank.com</sys:String>
    <sys:String x:Key="S.Menu.ExtrasGwRankRefresh">Refresh from GWRank</sys:String>
