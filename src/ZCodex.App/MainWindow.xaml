<Window x:Class="ZCodex.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZCodex.App.ViewModels"
        xmlns:conv="clr-namespace:ZCodex.App.Converters"
        xmlns:local="clr-namespace:ZCodex.App"
        xmlns:views="clr-namespace:ZCodex.App.Views"
        xmlns:ctrl="clr-namespace:ZCodex.App.Controls"
        xmlns:beh="clr-namespace:ZCodex.App.Behaviors"
        Title="{Binding ActiveTeamBuild.DisplayName, StringFormat='Z-Codex - [Team Build: {0}]', FallbackValue='Z-Codex'}"
        Width="1346" Height="828" MinWidth="900" MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- Converters partagés déplacés dans App.xaml (portée application). -->

        <!-- Tooltip PARESSEUX du slot d'éditeur : le SkillTooltipControl lourd (~30 visuels +
             parsing markup) n'est bâti qu'à l'ouverture de la ToolTip (Popup), pas à la
             matérialisation du slot. DataContext du template = le SlotVM (Skill/Footer/Description). -->
        <DataTemplate x:Key="SkillSlotTooltipTemplate">
            <ctrl:SkillTooltipControl Skill="{Binding Skill}"
                                      FooterOverride="{Binding Footer}"
                                      DescriptionOverride="{Binding Description}"
                                      DisplayDescriptionOverride="{Binding DisplayDescription}"
                                      AttributeRank="{Binding AttributeRank}"
                                      WeaponMastery="{Binding WeaponMastery}"
                                      WeaponMasteryRank="{Binding WeaponMasteryRank}"
                                      StrengthRank="{Binding StrengthRank}"
                                      CriticalStrikesRank="{Binding CriticalStrikesRank}"
                                      ExpertiseRank="{Binding ExpertiseRank}"
                                      SpawningPowerRank="{Binding SpawningPowerRank}"
                                      FluxEnergyPercent="{Binding FluxEnergyPercent}"
                                      FluxDamagePercent="{Binding FluxDamagePercent}"
                                      FluxCastPercent="{Binding FluxCastPercent}"
                                      NatureRituals="{Binding NatureRituals}"
                                      RoaringWindsBonus="{Binding RoaringWindsBonus}"
                                      EnchantEnchantingPct="{Binding EnchantEnchantingPct}"
                                      EnchantExtenderPct="{Binding EnchantExtenderPct}"
                                      EnchantTranquilityPct="{Binding EnchantTranquilityPct}"/>
        </DataTemplate>

        <!-- Tooltip du catalogue de recherche : DataContext de la cellule = le Skill lui-même. -->
        <DataTemplate x:Key="CatalogSkillTooltipTemplate">
            <ctrl:SkillTooltipControl Skill="{Binding}"/>
        </DataTemplate>

        <!-- Bandeau des 10 conditions infligeables (DataContext = ConditionBandViewModel) :
             couleur = infligée par une skill équipée (tooltip : par lesquelles), grisée =
             accessible au combo PR/SEC, quasi-éteinte = inaccessible (tooltip : description).
             Partagé par l'éditeur de build (sous les slots) et le teambuild (ligne unique). -->
        <DataTemplate x:Key="ConditionBandTemplate">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Background transparent : rend la case survolable même si l'icône
                             n'est pas encore téléchargée (tooltip toujours disponible). -->
                        <Border Width="24" Height="24" Margin="0,0,4,0" Background="Transparent"
                                ToolTipService.ShowDuration="30000">
                            <Border.ToolTip>
                                <TextBlock Text="{Binding ToolTipText}" MaxWidth="340" TextWrapping="Wrap"/>
                            </Border.ToolTip>
                            <Image Source="{Binding Icon}" Width="22" Height="22" Stretch="Uniform"
                                   Opacity="{Binding IconOpacity}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Bandeau des rituels de la nature ÉQUIPÉS (DataContext = NatureRitualBandViewModel) :
             icône togglable (clic = active/désactive l'environnement), grisée = inactif, cadre vert
             = actif. Se masque si aucun rituel équipé (HasItems). Partagé éditeur + teambuild. -->
        <DataTemplate x:Key="NatureRitualBandTemplate">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{DynamicResource S.Ed.RitualsLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MouseLeftButtonDown="NatureRitualToggle_Click"
                                    PreviewMouseWheel="NatureRitualRank_Wheel" Cursor="Hand"
                                    Width="26" Height="26" Margin="0,0,4,0" CornerRadius="2"
                                    BorderThickness="2" Background="Transparent"
                                    ToolTipService.ShowDuration="30000">
                                <!-- Tooltip = le VRAI tooltip de la compétence + note band-only (rang / clic). -->
                                <Border.ToolTip>
                                    <ToolTip MaxWidth="420" Padding="0">
                                        <StackPanel>
                                            <ctrl:SkillTooltipControl Skill="{Binding Skill}"
                                                                      DescriptionOverride="{Binding DescriptionOverride}"
                                                                      DisplayDescriptionOverride="{Binding DisplayDescriptionOverride}"
                                                                      AttributeRank="{Binding AttributeRank}"/>
                                            <TextBlock Text="{Binding ClickNote}" FontSize="10" FontStyle="Italic"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="6,2,6,4"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="#43A047"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Width="20" Height="20" Stretch="Uniform"
                                           Source="{Binding IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=64}"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Opacity" Value="0.35"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <!-- Badge de rang (Roaring Winds seulement) : rang de simulation, molette pour changer. -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Background="#CC000000" CornerRadius="2" Padding="1,0" Margin="0,0,-1,-1"
                                            Visibility="{Binding HasRank, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Rank}" FontSize="8" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Bandeau LOCAL des boosts d'attribut de compétences équipées (Lot A : Aura of the Lich,
             Awaken the Blood, Masochism, Expert's Dexterity, Trapper's Focus). DataContext =
             CharacterSlotViewModel directement (pas un ViewModel de bandeau partagé — contrairement
             aux rituels, l'effet est propre à CE perso). Icône togglable, cadre vert = actif. -->
        <DataTemplate x:Key="AttributeBoostBandTemplate">
            <ItemsControl ItemsSource="{Binding AttributeBoostToggles}"
                          Visibility="{Binding HasAttributeBoostToggles, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MouseLeftButtonDown="AttributeBoostToggle_Click" Cursor="Hand"
                                Width="18" Height="18" Margin="0,0,3,0" CornerRadius="2"
                                BorderThickness="2" Background="Transparent"
                                ToolTipService.ShowDuration="30000">
                            <!-- Tooltip = le VRAI tooltip de la compétence + note band-only (clic). -->
                            <Border.ToolTip>
                                <ToolTip MaxWidth="420" Padding="0">
                                    <StackPanel>
                                        <ctrl:SkillTooltipControl Skill="{Binding Skill}"/>
                                        <TextBlock Text="{Binding ClickNote}" FontSize="10" FontStyle="Italic"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="6,2,6,4"/>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="#43A047"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Width="14" Height="14" Stretch="Uniform"
                                   Source="{Binding Skill.IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=64}"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Opacity" Value="0.35"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <!-- Empêche le ToolBar de considérer ces boutons comme "en débordement" : sans ça,
                 HasOverflowItems reste figé à true après le tout premier passage de layout et le
                 bouton overflow (chevron) reste affiché en permanence, même une fois la fenêtre
                 largement assez large pour tout afficher. -->
            <Setter Property="ToolBar.OverflowMode" Value="Never"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SkillSlotStyle" TargetType="Border">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SlotBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SlotBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsElite}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFD700"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasViolation}" Value="True">
                    <Setter Property="BorderBrush" Value="#FF4444"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AttributeItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ligne des colonnes « Skill Types » et « Mechanics ». Hérite du style commun des
             panneaux de filtre et n'y ajoute qu'une chose : une ligne dont un ancêtre est replié
             disparaît. La collection, elle, reste plate et complète. -->
        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource AttributeItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Lignes des colonnes « Skill Types » et « Mechanics ». Toutes cliquables : les familles
             (Attacks, Spells…) sont passées en mécaniques, il n'y a plus d'intertitre décoratif.
             Indentation 0 = entrée méta « All … » ou famille de tête → SemiBold.
             Le chevron déplie/replie SANS sélectionner la ligne (le handler marque l'événement
             traité) : on veut pouvoir fouiller l'arbre sans relancer un filtrage à chaque pas. -->
        <DataTemplate x:Key="CategoryRowTemplate">
            <DockPanel Margin="{Binding Margin}">
                <TextBlock DockPanel.Dock="Left" Text="{Binding ExpanderGlyph}" Tag="{Binding}"
                           Width="12" FontSize="9" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Background="Transparent" MouseLeftButtonUp="CategoryExpander_Click"/>
                <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Indent}" Value="0">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <!-- Entrée qui ne rendrait rien avec les filtres actifs : grisée, mais
                                     toujours à sa place et cliquable (même règle que les puces). -->
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="AttributeRowTemplate">
            <Grid Margin="0,1" Tag="{Binding}" PreviewMouseWheel="AttrRow_MouseWheel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="66"/>  <!-- valeur : « 12+3 » + le +2 de flux + un boost de compétence -->
                    <ColumnDefinition Width="18"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Content="−" Tag="{Binding}"
                        Click="AttrDecrement_Click"
                        Width="16" Height="16" FontSize="10" Padding="0"
                        Background="Transparent" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1"/>
                <!-- Valeur : niveau+bonus, puis le +2 de flux (Hidden Talent / Meek) dans la couleur du flux -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PointsDisplay}" FontSize="11"/>
                    <TextBlock Text="{Binding FluxBonusDisplay}" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource FluxVariableBrush}"
                               Visibility="{Binding HasFluxBonus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding SkillBoostDisplay}" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource SkillBoostVariableBrush}"
                               Visibility="{Binding HasSkillBoost, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <Button Grid.Column="3" Content="+" Tag="{Binding}"
                        Click="AttrIncrement_Click"
                        Width="16" Height="16" FontSize="10" Padding="0"
                        Background="Transparent" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1"/>
            </Grid>
        </DataTemplate>

        <!-- Variante « recherche » : nom serré sur le plus long de son bloc (les spinners restent
             collés au nom ET alignés verticalement) puis colonne * de remplissage. Ne pas fusionner
             avec AttributeRowTemplate : l'éditeur a des colonnes étroites où le nom en * convient.
             Les 135 px en dur ont laissé place à Auto + SharedSizeGroup (20/08/2026), comme dans la
             vue Build : même rendu, mais plus rien à re-régler si un libellé s'allonge ou si on
             change de langue. La portée du partage est posée sur CHAQUE bloc de seuils. -->
        <DataTemplate x:Key="SearchAttributeRowTemplate">
            <Grid Margin="0,1" Tag="{Binding}" PreviewMouseWheel="AttrRow_MouseWheel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SearchAttrName" MinWidth="90"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Bascule ≥ / ≤ (au moins / au plus) pour ce seuil — recherche uniquement -->
                <Button Grid.Column="1" Content="{Binding ComparisonGlyph}" Tag="{Binding}"
                        Click="AttrToggleComparison_Click" Cursor="Hand"
                        ToolTip="{DynamicResource S.Ed.ThresholdToggle}"
                        Width="18" Height="16" FontSize="11" Padding="0" Margin="0,0,2,0"
                        Background="Transparent" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1"/>
                <Button Grid.Column="2" Content="−" Tag="{Binding}"
                        Click="AttrDecrement_Click"
                        Width="16" Height="16" FontSize="10" Padding="0"
                        Background="Transparent" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1"/>
                <TextBlock Grid.Column="3" Text="{Binding PointsDisplay}" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="4" Content="+" Tag="{Binding}"
                        Click="AttrIncrement_Click"
                        Width="16" Height="16" FontSize="10" Padding="0"
                        Background="Transparent" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1"/>
            </Grid>
        </DataTemplate>

        <!-- Boutons −/+ des lignes d'attribut de l'éditeur de build (4 par ligne : base + bonus).
             BasedOn OBLIGATOIRE : un Style à x:Key REMPLACE le style implicite du type au lieu de
             s'y ajouter. Sans lui, ces boutons perdaient le Foreground du thème (glyphe noir donc
             illisible en mode sombre) et le template natif du thème. -->
        <Style x:Key="AttrSpinnerStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SlotBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Variante « éditeur de build » : la colonne d'attributs y est large, on dédouble donc le
             spinner — niveau de base (0–12) à gauche, niveau bonus rune/casque/conso (0–20) à droite,
             puis le niveau effectif. Ne PAS généraliser aux deux autres templates : la carte du
             teambuild et la grille de seuils n'ont pas la place et gardent l'affichage combiné.
             Rang de titre (SupportsBonus faux) : ni bonus ni total, la base fait tout. -->
        <DataTemplate x:Key="EditorAttributeRowTemplate">
            <Grid Margin="0,1" Tag="{Binding}" PreviewMouseWheel="EditorAttrRow_MouseWheel">
                <Grid.ColumnDefinitions>
                    <!-- Auto + SharedSizeGroup : la colonne des noms prend la largeur du nom le plus
                         long de son bloc, et pas un pixel de plus — les lignes restent alignees entre
                         elles sans que le nom s'etire sur la moitie du panneau (maquette Philippe
                         20/08/2026). La portee du partage est posee sur CHAQUE bloc, donc les
                         caracteristiques primaires et secondaires se dimensionnent separement. -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorAttrName" MinWidth="90"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="24"/>   <!-- niveau de base -->
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/> <!-- libellé « bonus » -->
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="26"/>   <!-- niveau bonus -->
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="58"/>   <!-- « = 15 » + flux + boost de compétence -->
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11" Margin="0,0,4,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Niveau de base : mêmes handlers que les autres templates -->
                <Button Grid.Column="1" Content="−" Tag="{Binding}" Click="AttrDecrement_Click"
                        Style="{StaticResource AttrSpinnerStyle}"/>
                <TextBlock Grid.Column="2" Text="{Binding Points}" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Content="+" Tag="{Binding}" Click="AttrIncrement_Click"
                        Style="{StaticResource AttrSpinnerStyle}"/>
                <!-- Niveau bonus, hors budget -->
                <TextBlock Grid.Column="4" Text="{DynamicResource S.Ed.AttrBonus}" FontSize="9" Margin="10,0,4,0"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                           Visibility="{Binding SupportsBonus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Grid.Column="5" Content="−" Tag="{Binding}" Click="AttrBonusDecrement_Click"
                        Style="{StaticResource AttrSpinnerStyle}"
                        ToolTip="{DynamicResource S.Ed.AttrBonusTip}"
                        Visibility="{Binding SupportsBonus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Grid.Column="6" Text="{Binding BonusDisplay}" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SupportsBonus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Grid.Column="7" Content="+" Tag="{Binding}" Click="AttrBonusIncrement_Click"
                        Style="{StaticResource AttrSpinnerStyle}"
                        ToolTip="{DynamicResource S.Ed.AttrBonusTip}"
                        Visibility="{Binding SupportsBonus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <!-- Niveau effectif, puis le +2 de flux et celui d'un boost de compétence, chacun
                     dans sa couleur (mêmes canaux que l'affichage combiné des autres templates). -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding SupportsBonus, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding EffectiveDisplay}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FluxBonusDisplay}" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource FluxVariableBrush}"
                               Visibility="{Binding HasFluxBonus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding SkillBoostDisplay}" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource SkillBoostVariableBrush}"
                               Visibility="{Binding HasSkillBoost, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Onglet du catalogue de recherche (façon PawNed²). Groupe (HasChildren) = gras ;
             sélectionné = bleu. Sert aux deux rangées (groupes + sous-onglets). -->
        <Style x:Key="CatalogTabStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,2,0,0"/>
            <Setter Property="Background" Value="{DynamicResource InsetBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChildren}" Value="True">
                    <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="White"/>
                </DataTrigger>
                <!-- Puce des lignes Skill Types / Mechanics qui ne rendrait AUCUN résultat avec les
                     filtres actifs : grisée, mais toujours à sa place et toujours cliquable (idée
                     Philippe) — la liste ne bouge pas sous le curseur quand on change de profession.
                     Placé APRÈS le déclencheur de sélection : une puce vide mais sélectionnée doit
                     rester lisible sur le fond d'accentuation. -->
                <DataTrigger Binding="{Binding Category.IsEmpty}" Value="True">
                    <Setter Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CharacterSlotTemplate">
            <Border Tag="{Binding}" ContextMenuOpening="CharLeftPanel_ContextMenuOpening"
                    PreviewMouseLeftButtonDown="CharacterCard_MouseLeftButtonDown">
                <!-- Fond, liseré et marges passent par le Style : posés en attributs, ils
                     l'emporteraient sur le déclencheur ci-dessous (valeur locale > style) et le
                     personnage sélectionné ne se verrait jamais. -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Margin" Value="0,0,0,1"/>
                        <Style.Triggers>
                            <!-- Personnage sélectionné pour la molette : liseré d'accent à gauche, dont
                                 les 3 px sont repris en marge négative pour que le contenu de la carte
                                 ne se décale pas. Affiché seulement quand le toggle l'exige, sinon on
                                 signalerait un état sans le moindre effet. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.WheelNeedsSelection, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding IsWheelSelected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                <Setter Property="Margin" Value="-3,0,0,1"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <!-- Ordre : tout ce qui concerne LE personnage cliqué d'abord, les deux actions
                         de niveau team build en dernier. -->
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource S.Ctx.CharProps}" Click="CharacterProperties_Click"/>
                        <MenuItem Header="{DynamicResource S.Ctx.CharEquip}" Click="CharEquipment_Click"/>
                        <Separator/>
                        <!-- Copier / importer : code O et/ou P, brut ou code de chat. Les deux
                             chemins d'import sont séparés (cf. menu Édition) — un presse-papier
                             déjà chargé ne doit pas rendre le fichier inatteignable. -->
                        <MenuItem Header="{DynamicResource S.Ctx.CopyO}" InputGestureText="Ctrl+C"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Click="CopyTemplate_Click"/>
                        <MenuItem Header="{DynamicResource S.Ctx.CopyChat}"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Click="CopyChatCode_Click"/>
                        <MenuItem Header="{DynamicResource S.Ctx.CopyP}"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Click="CopyEquipment_Click"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource S.Ctx.ImportClipboard}" InputGestureText="Ctrl+V"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Click="ImportClipboardAny_Click"/>
                        <MenuItem Header="{DynamicResource S.Ctx.ImportFile}"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Click="ImportFileAny_Click"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource S.Ctx.AssignPlayer}" Tag="assign">
                            <MenuItem Header="{DynamicResource S.Ctx.Loading}"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{DynamicResource S.Ctx.SwapWith}" Tag="swap">
                            <MenuItem Header="{DynamicResource S.Ctx.Loading}"/>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource S.Ctx.MoveTo}" Tag="move">
                            <MenuItem Header="{DynamicResource S.Ctx.Loading}"/>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource S.Ctx.CopyTo}" Tag="copy">
                            <MenuItem Header="{DynamicResource S.Ctx.Loading}"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{DynamicResource S.Ctx.CreateVariant}" Click="CreateVariant_Click"/>
                        <MenuItem Header="{DynamicResource S.Ctx.LockVariants}" Click="LockVariants_Click"/>
                        <Separator/>
                        <!-- Vider le build de CETTE ligne : le personnage reste (nom, professions,
                             notes, équipement, joueur assigné), seul le contenu du template part.
                             Grisées quand il n'y a plus rien à retirer. -->
                        <MenuItem Header="{DynamicResource S.Ctx.ClearSkills}"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.Tag.HasAnySkill, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Click="ClearCharSkills_Click"/>
                        <MenuItem Header="{DynamicResource S.Ctx.ClearAttrs}"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.Tag.HasInvestedAttributes, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Click="ClearCharAttributes_Click"/>
                        <MenuItem Header="{DynamicResource S.Ctx.ClearBuild}"
                                  Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.Tag.HasBuildContent, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Click="ClearCharBuild_Click"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource S.Ctx.RemoveChar}" Click="RemoveCharacterSlot_Click"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource S.Ctx.AddChar}" Click="AddCharacterSlot_Click"/>
                        <MenuItem Header="{DynamicResource S.Ctx.SaveAssign}" Click="SaveAssignments_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Cadenas : une cellule par cadenas du build (colonnes fixes) → barres de même
                         indice alignées verticalement. Membre = barre colorée 🔒+indice, sinon espace vide. -->
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding LockCells}" VerticalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="18" MinHeight="40" Margin="0,0,1,0" Cursor="Hand"
                                        Tag="{Binding Lock}" VerticalAlignment="Stretch"
                                        ToolTip="{Binding Lock.MembersTooltip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMember}" Value="True">
                                                    <Setter Property="Background" Value="{Binding Lock.ColorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{Binding Lock.EditLabel}" Click="EditLock_Click"/>
                                            <MenuItem Header="{Binding Lock.RemoveLabel}" Click="RemoveLock_Click"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding Lock.ExportLabel}">
                                                <MenuItem Header="Format .pn3" Tag="pn3" Click="ExportLock_Click"/>
                                                <MenuItem Header="Image .png" Tag="png" Click="ExportLock_Click"/>
                                                <MenuItem Header="Chat codes .txt (O+P)" Tag="txt" Click="ExportLock_Click"/>
                                                <MenuItem Header="paw·ned² .pwnd" Tag="pwnd" Click="ExportLock_Click"/>
                                            </MenuItem>
                                            <MenuItem Header="{Binding Lock.ExportAsLabel}" Click="ExportLockAs_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding IsMember, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Lock.Index}" FontSize="12" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Sélection de cadenas : case alignée à gauche (hors indentation) + aperçu cadenas dès qu'on coche -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0"
                                Visibility="{Binding DataContext.ActiveTeamBuild.IsLockSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <CheckBox IsChecked="{Binding IsSelectedForLock}" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#C08000" VerticalAlignment="Center" Margin="3,0,0,0"
                                   ToolTip="{DynamicResource S.Row.LockPending}"
                                   Visibility="{Binding IsSelectedForLock, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                <StackPanel Grid.Column="2" Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}">
                <Grid MinHeight="{Binding DataContext.SlotRowMinHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                    <!-- Hauteur = MinHeight piloté par la taille d'icône (VM.SlotRowMinHeight : 88/74/72).
                         MinHeight et non Height : le cas courant (non assigné) se cale au plancher, mais une
                         ligne assignée grandit d'elle-même sans rogner le libellé. Racine et variante ont la
                         même structure verticale depuis la refonte 2×2 → une seule hauteur (plus de trigger). -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Character info — clic droit = opérations personnage -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center"
                                Margin="6,4,4,4" Tag="{Binding}">
                        <!-- Nom + indicateur de variante -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↳" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,3,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsVariant, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <!-- Rangée d'icônes : deux blocs 2×2 côte à côte (grille → alignement colonne garanti).
                             Bloc gauche = PR/SEC (haut) · repli-ou-gestion hiérarchie (bas).
                             Bloc droit  = crayon/étoile (haut) · armes/copier (bas).
                             → ✏ toujours au-dessus de ⚔, ☆ au-dessus de ⧉, PR/SEC au-dessus de la hiérarchie. -->
                        <Grid Margin="0,2,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- PR / hiérarchie -->
                                <ColumnDefinition Width="Auto"/>  <!-- SEC -->
                                <ColumnDefinition Width="6"/>     <!-- gouttière entre les deux blocs -->
                                <ColumnDefinition Width="Auto"/>  <!-- crayon / armes -->
                                <ColumnDefinition Width="Auto"/>  <!-- étoile / copier -->
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>    <!-- haut : PR SEC crayon étoile -->
                                <RowDefinition Height="Auto"/>    <!-- bas  : hiérarchie armes copier -->
                            </Grid.RowDefinitions>

                            <!-- HAUT-GAUCHE : Icône PR — clic gauche ouvre le picker de profession -->
                            <Border Grid.Row="0" Grid.Column="0" Width="24" Height="24" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="12"
                                    Margin="0,0,2,0" Cursor="Hand"
                                    MouseLeftButtonDown="PrimaryProfIcon_MouseDown">
                                <Grid>
                                    <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Visibility="{Binding HasPrimaryProfession, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                    <Image Source="{Binding PrimaryProfession, Converter={StaticResource ProfToIcon}}"
                                           Width="20" Height="20" Stretch="Uniform"
                                           ToolTip="{Binding PrimaryProfessionName}"
                                           Visibility="{Binding HasPrimaryProfession, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                            <!-- HAUT : Icône SEC — clic gauche ouvre le picker de profession -->
                            <Border Grid.Row="0" Grid.Column="1" Width="24" Height="24" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="12"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="SecondaryProfIcon_MouseDown">
                                <Grid>
                                    <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Visibility="{Binding HasSecondaryProfession, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                    <Image Source="{Binding SecondaryProfession, Converter={StaticResource ProfToIcon}}"
                                           Width="20" Height="20" Stretch="Uniform"
                                           ToolTip="{Binding SecondaryProfessionName}"
                                           Visibility="{Binding HasSecondaryProfession, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                            <!-- HAUT-DROITE : crayon (propriétés du personnage) — au-dessus des armes -->
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource IconMutedBrush}" Cursor="Hand"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,6,0"
                                       ToolTip="{DynamicResource S.Row.CharProps}"
                                       MouseLeftButtonUp="EditCharacter_Click"/>
                            <!-- HAUT-DROITE : étoile (save template .txt) — au-dessus de copier -->
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="★" FontSize="16" Foreground="#FFD700"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand"
                                       ToolTip="{DynamicResource S.Row.SaveBuildTxt}"
                                       MouseLeftButtonUp="SaveTemplate_Click"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="☆" FontSize="16" Foreground="{DynamicResource IconMutedBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand"
                                       ToolTip="{DynamicResource S.Row.SaveBuildTxt}"
                                       MouseLeftButtonUp="SaveTemplate_Click"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

                            <!-- BAS-GAUCHE : repli (root à variantes) + gestion (variante), sous PR/SEC -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,3,0,0">
                                <!-- repli (nœuds à variantes) -->
                                <Button Tag="{Binding}" Click="ToggleExpand_Click"
                                        Width="16" Height="16" Padding="0" FontSize="9" Margin="0,0,6,0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="{DynamicResource S.Row.FoldVariants}"
                                        Visibility="{Binding HasVariants, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid>
                                        <TextBlock Text="▼" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="▶" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                    </Grid>
                                </Button>
                                <!-- monter/descendre/échanger (variantes) -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsVariant, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Content="↑" Tag="{Binding}" Click="VariantUp_Click"
                                            Width="16" Height="16" Padding="0" FontSize="10" Margin="0,0,2,0"
                                            Background="Transparent" BorderBrush="{DynamicResource BorderStrongBrush}" Cursor="Hand"
                                            ToolTip="{DynamicResource S.Row.VarUp}"/>
                                    <Button Content="↓" Tag="{Binding}" Click="VariantDown_Click"
                                            Width="16" Height="16" Padding="0" FontSize="10" Margin="0,0,2,0"
                                            Background="Transparent" BorderBrush="{DynamicResource BorderStrongBrush}" Cursor="Hand"
                                            ToolTip="{DynamicResource S.Row.VarDown}"/>
                                    <Button Content="↩" Tag="{Binding}" Click="VariantSwap_Click"
                                            Width="16" Height="16" Padding="0" FontSize="10"
                                            Background="Transparent" BorderBrush="{DynamicResource BorderStrongBrush}" Cursor="Hand"
                                            ToolTip="{DynamicResource S.Row.VarSwap}"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- BAS-DROITE : Armes (épées croisées) = équipement, sous le crayon -->
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="⚔" FontSize="13" Foreground="#7A6E4F" Cursor="Hand"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3,6,0"
                                       ToolTip="{Binding EquipmentSummary}"
                                       MouseLeftButtonUp="EquipmentLabel_Click"
                                       Visibility="{Binding HasEquipment, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="⚔" FontSize="13" Foreground="{DynamicResource IconMutedBrush}" Cursor="Hand"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3,6,0"
                                       ToolTip="{DynamicResource S.Row.NoEquip}"
                                       MouseLeftButtonUp="EquipmentLabel_Click"
                                       Visibility="{Binding HasEquipment, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                            <!-- BAS-DROITE : Copier (sous l'étoile) — visible dès que le build porte une modif impactant le chat code -->
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource IconMutedBrush}" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3,0,0"
                                       ToolTip="{DynamicResource S.Row.CopyTpl}"
                                       MouseLeftButtonUp="CopyCharacter_Click"
                                       Visibility="{Binding IsEmptyBuild, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                            <!-- BAS-DROITE : Import (sous l'étoile) — visible si le build est vide ; colle un code du presse-papier -->
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource IconMutedBrush}" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3,0,0"
                                       ToolTip="{DynamicResource S.Row.ImportTpl}"
                                       MouseLeftButtonUp="ImportTemplateIcon_Click"
                                       Visibility="{Binding IsEmptyBuild, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                        <!-- Toggle « prolongateurs de durée d'enchantement » (Blessed Aura / Extend
                             Enchantments) du perso — n'apparaît que s'il en porte un (HasDurationBooster).
                             Ambre = actif : ses enchantements Monk/Derviche voient leur durée rallongée
                             (ambre) dans les infobulles. Même idiome ★/☆ (2 TextBlocks superposés). -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                    Visibility="{Binding HasDurationBooster, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="13" Cursor="Hand"
                                       VerticalAlignment="Center" Foreground="{DynamicResource RitualVariableBrush}"
                                       ToolTip="{DynamicResource S.Row.BoostersOnTip}"
                                       MouseLeftButtonUp="DurationBoosters_Click"
                                       Visibility="{Binding DurationBoostersEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="13" Cursor="Hand"
                                       VerticalAlignment="Center" Foreground="{DynamicResource IconMutedBrush}"
                                       ToolTip="{DynamicResource S.Row.BoostersOffTip}"
                                       MouseLeftButtonUp="DurationBoosters_Click"
                                       Visibility="{Binding DurationBoostersEnabled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </StackPanel>
                        <!-- Bandeau local des boosts d'attribut (Lot A) — se masque de lui-même si
                             aucune compétence qualifiante équipée (HasAttributeBoostToggles). -->
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AttributeBoostBandTemplate}"
                                        Margin="0,3,0,0" Focusable="False"/>
                        <!-- Clic gauche sur le nom du joueur assigné → ouvre le même menu -->
                        <TextBlock Text="{Binding Assignment}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   Background="Transparent" Cursor="Hand"
                                   MouseLeftButtonUp="AssignmentLabel_Click"
                                   Visibility="{Binding IsAssigned, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Right: 8 skill slots + overlay attributs (groupe calé à gauche → overlay au bord droit du slot 8) -->
                    <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,4,4,4">
                    <ItemsControl x:Name="SlotsItemsControl" ItemsSource="{Binding SkillSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SkillSlotStyle}"
                                        Width="{Binding DataContext.SlotSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.SlotSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AllowDrop="True"
                                        Focusable="True"
                                        FocusVisualStyle="{x:Null}"
                                        ToolTipService.IsEnabled="{Binding HasSkill}"
                                        Drop="SkillSlot_Drop"
                                        DragEnter="SkillSlot_DragEnter"
                                        DragOver="SkillSlot_DragOver"
                                        DragLeave="SkillSlot_DragLeave"
                                        PreviewMouseLeftButtonDown="SkillSlot_PreviewMouseDown"
                                        PreviewMouseMove="SkillSlot_PreviewMouseMove"
                                        KeyDown="SkillSlot_KeyDown"
                                        PreviewMouseWheel="SkillSlot_MouseWheel">
                                    <Border.ToolTip>
                                        <!-- Placement=Bottom ancre le HAUT de l'infobulle sur le BAS du slot : elle
                                             descend sous la rangée, donc sous l'overlay d'attributs (bas-droite du
                                             slot). La bande d'attributs qu'on ajuste à la molette reste visible
                                             AU-DESSUS d'elle. Cf. suppression pendant la molette. -->
                                        <ToolTip Placement="Bottom">
                                            <ctrl:SkillTooltipControl Skill="{Binding Skill}"
                                                                      FooterOverride="{Binding Footer}"
                                                                      DescriptionOverride="{Binding Description}"
                                                                      DisplayDescriptionOverride="{Binding DisplayDescription}"
                                                                      AttributeRank="{Binding AttributeRank}"
                                                                      WeaponMastery="{Binding WeaponMastery}"
                                                                      WeaponMasteryRank="{Binding WeaponMasteryRank}"
                                                                      StrengthRank="{Binding StrengthRank}"
                                                                      CriticalStrikesRank="{Binding CriticalStrikesRank}"
                                                                      ExpertiseRank="{Binding ExpertiseRank}"
                                                                      SpawningPowerRank="{Binding SpawningPowerRank}"
                                                                      FluxEnergyPercent="{Binding FluxEnergyPercent}"
                                                                      FluxDamagePercent="{Binding FluxDamagePercent}"
                                                                      FluxCastPercent="{Binding FluxCastPercent}"
                                                                      NatureRituals="{Binding NatureRituals}"
                                                                      RoaringWindsBonus="{Binding RoaringWindsBonus}"
                                                                      EnchantEnchantingPct="{Binding EnchantEnchantingPct}"
                                                                      EnchantExtenderPct="{Binding EnchantExtenderPct}"
                                                                      EnchantTranquilityPct="{Binding EnchantTranquilityPct}"/>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <Border.ContextMenu>
                                        <!-- Mêmes entrées que le menu du catalogue (agissent sur la compétence du slot
                                             via ContextMenuSkill), + suppression du slot en bas. -->
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{DynamicResource S.Ctx.SkillArticle}" Click="OpenSkillArticle_Click"
                                                      IsEnabled="{Binding HasSkill}"/>
                                            <MenuItem Header="{DynamicResource S.Ctx.SkillTalk}" Click="OpenSkillDiscussion_Click"
                                                      IsEnabled="{Binding HasSkill}"/>
                                            <MenuItem Header="{DynamicResource S.Ctx.SkillParse}" Click="ParseSkillInTemplates_Click"
                                                      IsEnabled="{Binding HasSkill}"/>
                                            <Separator/>
                                            <MenuItem Header="{DynamicResource S.Ctx.SkillRemove}" Click="ClearSkillSlot_Click"
                                                      IsEnabled="{Binding HasSkill}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <TextBlock Text="?" FontSize="24" FontWeight="Bold"
                                                   Foreground="{DynamicResource IconMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <!-- "?" si slot vide, MAIS pas si barré (hérité = identique parent) -->
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSkill}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ShowBarred}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding Skill.IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=64}"
                                               Width="{Binding DataContext.SlotImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Height="{Binding DataContext.SlotImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Stretch="Uniform" Margin="3"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <!-- icône si skill présente, MAIS masquée si barré -->
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSkill}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ShowBarred}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <!-- Diagonale "hérité du parent" -->
                                        <Path Stroke="{DynamicResource SlotBorderBrush}" StrokeThickness="2" Stretch="Fill"
                                              Data="M0,0 L1,1" Margin="6"
                                              Visibility="{Binding ShowBarred, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Overlay : attributs investis, fond noir, aligné en bas à droite du slot 8 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="#CC000000" CornerRadius="2" Padding="3,0,3,1"
                            Margin="0,0,2,1"
                            MaxWidth="{Binding ActualWidth, ElementName=SlotsItemsControl}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AttributeOverlay}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock beh:SkillMarkup.Text="{Binding AttributeOverlayMarkup}" FontSize="8.5"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding AttributeOverlay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverAttributeBudget}" Value="True">
                                            <Setter Property="Foreground" Value="#FF5555"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    </Grid>
                </Grid>
                <!-- Attribute editor (collapsible via Show attributes) -->
                <Border Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0"
                        Visibility="{Binding ShowAttributeEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                    <Grid Margin="4,4,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Points counter -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6">
                            <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverAttributeBudget}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding TotalAttributePoints, Mode=OneWay}"/><Run Text="/200"/>
                            </TextBlock>
                            <TextBlock Text="attr pts" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- Primary profession attributes -->
                        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,1,0" Margin="2,0">
                            <ItemsControl ItemsSource="{Binding PrimaryAttributeRows}"
                                          ItemTemplate="{StaticResource AttributeRowTemplate}" Margin="4,2"/>
                        </Border>
                        <!-- Secondary profession attributes -->
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding SecondaryAttributeRows}"
                                      ItemTemplate="{StaticResource AttributeRowTemplate}" Margin="6,2,2,2"/>
                    </Grid>
                    <!-- Mod "of the profession" : force la carac primaire de la profession choisie à 5 -->
                    <StackPanel Orientation="Horizontal" Margin="116,0,4,4">
                        <CheckBox Content="mod of the" VerticalAlignment="Center"
                                  IsChecked="{Binding OfProfessionModEnabled}"/>
                        <ComboBox Width="120" Margin="6,0,0,0" VerticalAlignment="Center"
                                  ItemsSource="{Binding ModProfessions}"
                                  SelectedItem="{Binding OfProfessionModProfession}"
                                  IsEnabled="{Binding OfProfessionModEnabled}"/>
                    </StackPanel>
                    <!-- Rangs de titre PvE (0–10, hors budget) — uniquement les pistes utilisées -->
                    <StackPanel Margin="116,0,4,6"
                                Visibility="{Binding HasTitleRanks, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource S.Ed.TitleRanks}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,1"/>
                        <ItemsControl ItemsSource="{Binding TitleRankRows}"
                                      ItemTemplate="{StaticResource AttributeRowTemplate}"/>
                    </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Menu bar. Le liseré du bas est porté par le Border englobant et non par le Menu :
             il doit courir sous toute la rangée, drapeaux compris. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">

        <!-- Raccourci de langue, tout en haut à droite. Doublon assumé du menu Affichage ▸ Langue :
             c'est le réglage qu'on cherche en premier dans une app bilingue, il doit être visible
             sans ouvrir de menu. Drapeaux dessinés en vectoriel — aucun asset à embarquer, net à
             toute résolution, et insensible au fait que Windows ne rend pas les émojis de pays. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,0,8,0">
            <Button x:Name="LangFrButton" Click="LangFr_Click" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,5,0"
                    ToolTip="Français">
                <Border x:Name="LangFrBorder" BorderThickness="1" CornerRadius="2" Padding="1">
                    <Viewbox Width="22" Height="15">
                        <Canvas Width="60" Height="40">
                            <Rectangle Width="20" Height="40" Fill="#002395"/>
                            <Rectangle Canvas.Left="20" Width="20" Height="40" Fill="#FFFFFF"/>
                            <Rectangle Canvas.Left="40" Width="20" Height="40" Fill="#ED2939"/>
                        </Canvas>
                    </Viewbox>
                </Border>
            </Button>
            <Button x:Name="LangEnButton" Click="LangEn_Click" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    ToolTip="English">
                <Border x:Name="LangEnBorder" BorderThickness="1" CornerRadius="2" Padding="1">
                    <Viewbox Width="22" Height="15">
                        <!-- Union Jack simplifié : les diagonales rouges sont centrées au lieu
                             d'être décalées comme sur le vrai pavillon — invisible à 22 px. -->
                        <Canvas Width="60" Height="40" ClipToBounds="True">
                            <Rectangle Width="60" Height="40" Fill="#012169"/>
                            <Line X1="0" Y1="0" X2="60" Y2="40" Stroke="#FFFFFF" StrokeThickness="8"/>
                            <Line X1="60" Y1="0" X2="0" Y2="40" Stroke="#FFFFFF" StrokeThickness="8"/>
                            <Line X1="0" Y1="0" X2="60" Y2="40" Stroke="#C8102E" StrokeThickness="3"/>
                            <Line X1="60" Y1="0" X2="0" Y2="40" Stroke="#C8102E" StrokeThickness="3"/>
                            <Rectangle Canvas.Top="13.5" Width="60" Height="13" Fill="#FFFFFF"/>
                            <Rectangle Canvas.Left="23.5" Width="13" Height="40" Fill="#FFFFFF"/>
                            <Rectangle Canvas.Top="16" Width="60" Height="8" Fill="#C8102E"/>
                            <Rectangle Canvas.Left="26" Width="8" Height="40" Fill="#C8102E"/>
                        </Canvas>
                    </Viewbox>
                </Border>
            </Button>
        </StackPanel>

        <Menu Background="Transparent" BorderThickness="0">
            <MenuItem Header="{DynamicResource S.Menu.File}" SubmenuOpened="FileMenu_SubmenuOpened">
                <MenuItem Header="{DynamicResource S.Menu.FileNewTeam}" Click="NewTeamBuild_Click"/>
                <MenuItem Header="{DynamicResource S.Menu.FileNewBuild}" Click="NewBuild_Click"/>
                <MenuItem Header="{DynamicResource S.Menu.FileNewEquip}" Click="NewEquipmentTemplate_Click"/>
                <MenuItem Header="{DynamicResource S.Menu.FileOpen}" Click="Open_Click"/>
                <Separator/>
                <!-- Command et non Click : le CommandBinding de la fenêtre porte le raccourci
                     clavier, et un seul chemin sert le menu, la barre d'outils et Ctrl+S.
                     Save affiche « Ctrl+S » tout seul (geste par défaut d'ApplicationCommands) ;
                     SaveAs n'en a pas, d'où l'InputGestureText explicite. -->
                <MenuItem Header="{DynamicResource S.Menu.FileSave}" Command="Save"/>
                <MenuItem Header="{DynamicResource S.Menu.FileSaveAs}" Command="SaveAs"
                          InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <!-- Export vers paw·ned². Chemin DISTINCT de l'export .pwnd d'un cadenas (menu
                     contextuel du cadenas) : celui-ci porte les 3 portées, dont le cadenas, et
                     aucun des deux ne doit cacher l'autre. Sous-menu des cadenas construit en
                     code dans FileMenu_SubmenuOpened. -->
                <MenuItem x:Name="ExportPwndMenuItem" Header="{DynamicResource S.Menu.FileExportPwnd}">
                    <MenuItem Header="{DynamicResource S.Menu.ExportPwndAll}" Click="ExportPwndAll_Click"/>
                    <MenuItem Header="{DynamicResource S.Menu.ExportPwndFirst8}" Click="ExportPwndFirst8_Click"/>
                    <MenuItem x:Name="ExportPwndLocksMenuItem" Header="{DynamicResource S.Menu.ExportPwndLock}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource S.Menu.FileExit}" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource S.Menu.Edit}" SubmenuOpened="EditMenu_SubmenuOpened">
                <!-- ApplicationCommands : un TextBox focusé garde son undo natif, sinon le
                     CommandBinding de la fenêtre route vers l'UndoManager du build actif. -->
                <MenuItem Header="{DynamicResource S.Menu.EditUndo}" Command="Undo"/>
                <MenuItem Header="{DynamicResource S.Menu.EditRedo}" Command="Redo"/>
                <Separator/>
                <MenuItem x:Name="CopyTemplateMenuItem" Header="{DynamicResource S.Ctx.CopyO}"
                          Click="CopyTemplateMenu_Click"/>
                <MenuItem x:Name="CopyChatCodeMenuItem" Header="{DynamicResource S.Ctx.CopyChat}"
                          Click="CopyChatCodeMenu_Click"/>
                <Separator/>
                <!-- Deux chemins SÉPARÉS (et non le combiné de l'icône ⤓) : sinon un
                     presse-papier contenant déjà un code rendrait le fichier inatteignable. -->
                <MenuItem x:Name="ImportClipboardMenuItem" Header="{DynamicResource S.Ctx.ImportClipboard}"
                          Click="ImportClipboardMenu_Click"/>
                <MenuItem x:Name="ImportFileMenuItem" Header="{DynamicResource S.Ctx.ImportFile}"
                          Click="ImportFileMenu_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource S.Menu.View}" SubmenuOpened="ViewMenu_SubmenuOpened">
                <MenuItem x:Name="ShowAttributesMenuItem" Header="{DynamicResource S.Menu.ViewShowAttrs}"
                          IsCheckable="True" Click="ShowAttributesMenuItem_Click"/>
                <!-- Molette du teambuild : n'autoriser le réglage des caractéristiques que sur le
                     personnage cliqué. Décoché par défaut = geste paw·ned². Persisté settings.json. -->
                <MenuItem x:Name="WheelNeedsSelectionMenuItem" Header="{DynamicResource S.Menu.ViewWheelSelect}"
                          ToolTip="{DynamicResource S.Menu.ViewWheelSelectTip}"
                          IsCheckable="True" Click="WheelNeedsSelectionMenuItem_Click"/>
                <!-- Filtres « Skill Types » et « Mechanics » du catalogue, INDÉPENDANTS l'un de
                     l'autre : mêmes booléens que les deux cases à cocher des barres de recherche.
                     Masquer un filtre remet CE filtre-là sur « All ». -->
                <MenuItem x:Name="ShowTypeColumnMenuItem" Header="{DynamicResource S.Menu.ViewTypeColumn}"
                          ToolTip="{DynamicResource S.Cat.ToggleTypesTip}"
                          IsCheckable="True" Click="ShowTypeColumnMenuItem_Click"/>
                <MenuItem x:Name="ShowMechanicColumnMenuItem" Header="{DynamicResource S.Menu.ViewMechanicColumn}"
                          ToolTip="{DynamicResource S.Cat.ToggleMechanicsTip}"
                          IsCheckable="True" Click="ShowMechanicColumnMenuItem_Click"/>
                <MenuItem x:Name="ShowPreviewAttributesMenuItem"
                          Header="{DynamicResource S.Menu.ViewPreviewAttrs}"
                          IsCheckable="True" Click="ShowPreviewAttributesMenuItem_Click"/>
                <!-- Bandeaux des conditions infligeables : sous le build (éditeur) et en ligne
                     unique au-dessus du teambuild. Persisté dans settings.json. -->
                <MenuItem x:Name="ShowConditionsMenuItem" Header="{DynamicResource S.Menu.ViewConditions}"
                          IsCheckable="True" Click="ShowConditionsMenuItem_Click"/>
                <!-- Dégâts théoriques selon l'armure dans l'infobulle de skill (contexte build) :
                     colonnes AL 60/80/100/120 + AL custom, niveaux du perso (formules) et de la
                     cible (taux de critique). Persisté dans settings.json. -->
                <MenuItem x:Name="ShowArmorDamageMenuItem" Header="{DynamicResource S.Menu.ViewArmorDamage}"
                          IsCheckable="True" Click="ShowArmorDamage_Click"/>
                <MenuItem x:Name="CustomArmorLevelMenuItem" Header="{DynamicResource S.Menu.ViewArmorDamageConfig}"
                          Click="CustomArmorLevel_Click"/>
                <Separator/>
                <!-- Affiche/masque la barre des rituels de la nature (au-dessus du teambuild / sous l'éditeur). -->
                <MenuItem x:Name="ShowNatureRitualBandMenuItem" Header="{DynamicResource S.Menu.ViewRitualBand}"
                          IsCheckable="True" Click="ShowNatureRitualBandMenuItem_Click"/>
                <!-- Affiche TOUTES les icônes de rituels dans le bandeau (cliquables même non
                     équipées) pour les activer directement / simuler. -->
                <MenuItem x:Name="ShowAllNatureRitualsMenuItem" Header="{DynamicResource S.Menu.ViewAllRituals}"
                          IsCheckable="True" Click="ShowAllNatureRitualsMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource S.Menu.ViewIconSize}">
                    <MenuItem x:Name="IconsLargeMenuItem" Header="{DynamicResource S.Menu.IconLarge}"
                              IsCheckable="True" Click="IconsLarge_Click"/>
                    <MenuItem x:Name="IconsMediumMenuItem" Header="{DynamicResource S.Menu.IconMedium}"
                              IsCheckable="True" Click="IconsMedium_Click"/>
                    <MenuItem x:Name="IconsSmallMenuItem" Header="{DynamicResource S.Menu.IconSmall}"
                              IsCheckable="True" Click="IconsSmall_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="DarkThemeMenuItem" Header="{DynamicResource S.Menu.ViewDarkTheme}"
                          IsCheckable="True" Click="DarkTheme_Click"/>
                <Separator/>
                <!-- Langue : chrome UI (DynamicResource) + textes des compétences (Display*). -->
                <MenuItem Header="{DynamicResource S.Menu.Language}">
                    <MenuItem x:Name="LangFrMenuItem" Header="Français"
                              IsCheckable="True" Click="LangFr_Click"/>
                    <MenuItem x:Name="LangEnMenuItem" Header="English"
                              IsCheckable="True" Click="LangEn_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="ScreenshotMenuItem" Header="{DynamicResource S.Menu.ViewScreenshot}"
                          Click="Screenshot_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource S.Menu.Selection}" SubmenuOpened="SelectionMenu_SubmenuOpened">
                <MenuItem x:Name="OpenSelectedMenuItem" Header="{DynamicResource S.Menu.SelOpenBuild}"
                          Click="OpenSelectedBuild_Click"/>
                <Separator/>
                <!-- Items (Aucun + 12 flux) construits dynamiquement dans SelectionMenu_SubmenuOpened. -->
                <MenuItem x:Name="FluxMenuItem" Header="Flux"/>
                <!-- Rituels de la nature (énergie/recharge) : les 8 items cochables sont construits
                     dynamiquement dans SelectionMenu_SubmenuOpened. Environnement global au build. -->
                <MenuItem x:Name="NatureRitualMenuItem" Header="{DynamicResource S.Menu.SelRituals}"/>
            </MenuItem>
            <MenuItem Header="Extras" SubmenuOpened="ExtrasMenu_SubmenuOpened">
                <MenuItem Header="{DynamicResource S.Menu.ExtrasUpdateSkills}" Click="UpdateSkills_Click"/>
                <!-- Sous la mise à jour du catalogue, qui ne répare PAS ces icônes-là : les jeux
                     à taille fixe (stats, professions, conditions, flux, vol de vie) ne sont
                     tirés qu'au démarrage, et un premier téléchargement raté n'avait jusqu'ici
                     aucun recours côté utilisateur. -->
                <MenuItem Header="{DynamicResource S.Menu.ExtrasCheckIcons}" Click="CheckIcons_Click"/>
                <!-- Recalcule la colonne « Mechanics » du catalogue (enchantements, maintien,
                     sacrifice, conditions infligées…). Hors du groupe « internet » ci-dessous :
                     à ce stade tout se déduit de la base, rien n'est téléchargé. -->
                <MenuItem Header="{DynamicResource S.Menu.ExtrasRecomputeCategories}" Click="RecomputeCategories_Click"/>
                <!-- Voisines de la mise à jour du catalogue : ces entrées vont chercher de la
                     donnée sur internet, et ce sont les seules du menu à le faire. -->
                <MenuItem Header="{DynamicResource S.Menu.ExtrasPvx}" Click="PvxImport_Click"/>
                <!-- Import d'un match réel depuis gvg.report. Sous l'import PvX : même geste
                     (aller chercher des builds ailleurs), autre source. -->
                <MenuItem Header="{DynamicResource S.Menu.ExtrasGvgReport}" Click="GvgReportImport_Click"/>
                <!-- Dépôt du teambuild actif sur GWRank. Voisin de l'import PvX : même
                     groupe « ces entrées parlent à internet ». -->
                <MenuItem Header="{DynamicResource S.Menu.ExtrasGwRankSend}" Click="GwRankSend_Click"/>
                <MenuItem Header="{DynamicResource S.Menu.ExtrasGwRankBulk}" Click="GwRankBulk_Click"/>
                <MenuItem Header="{DynamicResource S.Menu.ExtrasGwRankSettings}" Click="GwRankSettings_Click"/>
                <MenuItem Header="{DynamicResource S.Menu.ExtrasGwRankRefresh}" Click="GwRankRefresh_Click"/>
                <!-- Case a cocher : l'etat est relu a l'ouverture du menu (ExtrasMenu_SubmenuOpened),
                     car le reglage peut avoir change ailleurs. -->
                <MenuItem x:Name="GwRankStartupMenuItem" IsCheckable="True"
                          Header="{DynamicResource S.Menu.ExtrasGwRankStartup}"
                          Click="GwRankSyncOnStartup_Click"/>
                <Separator/>
                <!-- Sites de builds ouverts dans le navigateur (rien n'est téléchargé ici) —
                     mêmes destinations que le bouton « Partager le build » de la barre d'outils. -->
                <MenuItem Header="GW1 Builds" Click="OpenGw1Builds_Click"/>
                <MenuItem Header="GW PvX Fandom Wiki" Click="OpenGwPvx_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource S.Menu.ExtrasArmorCalc}" Click="ArmorCalculator_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource S.Menu.Window}" SubmenuOpened="WindowMenu_SubmenuOpened">
                <MenuItem Header="(placeholder)"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource S.Menu.Help}">
                <!-- Command="Help" = ApplicationCommands.Help : geste F1 natif + InputGestureText auto. -->
                <MenuItem Header="{DynamicResource S.Menu.HelpHelp}" Command="Help"/>
                <Separator/>
                <MenuItem Header="{DynamicResource S.Menu.HelpCheckUpdate}" Click="CheckUpdate_Click"/>
                <MenuItem Header="{DynamicResource S.Menu.HelpAbout}" Click="About_Click"/>
            </MenuItem>
        </Menu>
        </DockPanel>
        </Border>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Background="{DynamicResource WindowBackgroundBrush}">
            <ToolBar Band="1" BandIndex="1" Background="{DynamicResource WindowBackgroundBrush}"
                     Loaded="MainToolBar_Loaded">
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="{DynamicResource S.Tb.NewTeam}" Click="NewTeamBuild_Click">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3F9142"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="{DynamicResource S.Tb.NewBuild}" Click="NewBuild_Click">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#C77DBB"/>
                </Button>
                <!-- Équipement : ⚔ (et non un glyphe MDL2) — c'est déjà le symbole de
                     l'équipement sur les cartes de personnage, autant garder le même.

                     FontSize 13.5 et non 15 comme ses voisins : U+2694 n'existe pas dans Segoe UI,
                     WPF le fait donc rendre par Segoe UI Emoji, dont l'encre occupe ~1,12 px par
                     point de FontSize contre 1,00 pour Segoe MDL2 Assets. À 15 il dépasserait de
                     20 % ; à 13.5 il retombe sur les ~15 px d'encre des autres boutons.
                     Toucher à cette valeur sans remesurer refait l'écart. -->
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="{DynamicResource S.Tb.NewEquip}" Click="NewEquipmentTemplate_Click">
                    <TextBlock Text="⚔" FontSize="13.5" Foreground="#B08D57"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="{DynamicResource S.Tb.Open}" Click="Open_Click">
                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#E0A22C"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="{DynamicResource S.Tb.Save}" Click="Save_Click">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#2E75B6"/>
                </Button>
                <Separator ToolBar.OverflowMode="Never"/>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="{DynamicResource S.Tb.Search}" Click="SearchTemplates_Click">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#7A5CB5"/>
                </Button>
                <!-- Partage : deux sites de builds → menu déroulant plutôt qu'une destination
                     imposée. Mêmes entrées que le menu Extras. -->
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="{DynamicResource S.Tb.Share}" Click="ShareBuild_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="GW1 Builds" Click="OpenGw1Builds_Click"/>
                            <MenuItem Header="GW PvX Fandom Wiki" Click="OpenGwPvx_Click"/>
                            <MenuItem Header="GWRank" Click="OpenGwRank_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#2AA0A0"/>
                </Button>
                <!-- Envoi direct sur GWRank, voisin du menu des sites de builds : le monde OUVRE
                     un site, celui-ci DEPOSE le build ouvert. Deux gestes distincts, d'ou deux
                     boutons et non une entree de plus dans le menu. -->
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="{DynamicResource S.Tb.GwRankSend}"
                        Click="GwRankSendToolbar_Click">
                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#4E9A4E"/>
                </Button>
                <Separator ToolBar.OverflowMode="Never"/>
                <!-- Mode de jeu : INDICATEUR permanent du filtre PvE/PvP, qui est global à la
                     session et peut changer sans action directe (ouvrir un .pn3 v17 le
                     repositionne). Un clic cycle Tout → PvE → PvP. Plus large que les autres
                     boutons : il porte du texte et non une icône, l'état devant se lire d'un
                     coup d'œil. -->
                <Button Style="{StaticResource ToolbarButtonStyle}" Width="38"
                        ToolTip="{DynamicResource S.Tb.GameMode}" Click="CycleGameMode_Click">
                    <TextBlock Text="{Binding SkillPanel.GameModeLabel}" FontSize="11" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SkillPanel.SelectedGameMode}" Value="PvE">
                                        <Setter Property="Foreground" Value="#3F9142"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SkillPanel.SelectedGameMode}" Value="PvP">
                                        <Setter Property="Foreground" Value="#C0392B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Tab bar: browser tab (fixed) + open build tabs -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource TabStripBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1" Height="32">
            <StackPanel Orientation="Horizontal">
                <!-- Browser tab (always present, can't be closed) -->
                <Button Click="BrowserTab_Click" Margin="4,4,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="Team Builds"/>
                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Setter Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter Property="Padding" Value="10,4"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBrowserActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- Build tabs -->
                <ItemsControl ItemsSource="{Binding OpenTeamBuilds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="BuildTab_Click"
                                    MouseDown="BuildTab_MouseDown"
                                    MouseDoubleClick="Tab_DoubleClick"
                                    Margin="2,4,0,0">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource S.Tab.Rename}" Click="RenameTab_MenuClick"/>
                                        <MenuItem Header="{DynamicResource S.Tab.Close}" Click="CloseTab_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                        <Setter Property="BorderThickness" Value="1,1,1,0"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 MinWidth="90" Padding="1,0" VerticalAlignment="Center"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 IsVisibleChanged="RenameBox_IsVisibleChanged"
                                                 KeyDown="RenameBox_KeyDown"
                                                 LostFocus="RenameBox_LostFocus"/>
                                    </Grid>
                                    <Button Click="CloseTab_Click" Margin="6,0,0,0"
                                            Width="16" Height="16"
                                            VerticalAlignment="Center" ToolTip="{DynamicResource S.Tab.Close}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="✕"/>
                                                <Setter Property="FontSize" Value="9"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#CC4444"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#AA2222"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Build tabs (un onglet par build simple ouvert/créé) -->
                <ItemsControl ItemsSource="{Binding OpenBuilds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="BuildEditorTab_Click"
                                    MouseDown="BuildEditorTab_MouseDown"
                                    Margin="2,4,0,0">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource S.Tab.Close}" Click="CloseBuildEditorTab_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                        <Setter Property="BorderThickness" Value="1,1,1,0"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <!-- DisplayName et non Title : préfixé d'un * quand le build a
                                         des modifications non enregistrées, comme les team builds. -->
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                    <Button Click="CloseBuildEditorTab_Click" Margin="6,0,0,0"
                                            Width="16" Height="16"
                                            VerticalAlignment="Center" ToolTip="{DynamicResource S.Tab.Close}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="✕"/>
                                                <Setter Property="FontSize" Value="9"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#CC4444"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#AA2222"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Search builder tab (apparaît après un premier clic sur 🔍) -->
                <Button Click="SearchTemplates_Click" Margin="2,4,0,0"
                        Visibility="{Binding HasSearchBuilder, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="Search"/>
                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Setter Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter Property="Padding" Value="10,4"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchBuilderActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- Onglet Armure (apparaît après un premier clic sur Extras → Calculateur d'armure ;
                     fermable, l'état du calculateur est conservé) -->
                <Button Click="ArmorCalculatorTab_Click" Margin="2,4,0,0"
                        Visibility="{Binding HasArmorCalc, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource S.Tab.Close}" Click="CloseArmorCalcTab_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Setter Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter Property="Padding" Value="10,4"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsArmorCalcActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource S.Tab.Armor}" VerticalAlignment="Center"/>
                        <Button Click="CloseArmorCalcTab_Click" Margin="6,0,0,0"
                                Width="16" Height="16"
                                VerticalAlignment="Center" ToolTip="{DynamicResource S.Tab.CloseKeep}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="✕"/>
                                    <Setter Property="FontSize" Value="9"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#CC4444"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#AA2222"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Button>
                <!-- Search results tabs (un onglet « Résultats N » par lancement de recherche) -->
                <ItemsControl ItemsSource="{Binding SearchResultsTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="SearchResultsTab_Click"
                                    MouseDown="SearchResultsTab_MouseDown"
                                    MouseDoubleClick="Tab_DoubleClick"
                                    Margin="2,4,0,0">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource S.Tab.Rename}" Click="RenameTab_MenuClick"/>
                                        <MenuItem Header="{DynamicResource S.Tab.Close}" Click="CloseSearchResultsTab_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                        <Setter Property="BorderThickness" Value="1,1,1,0"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 MinWidth="90" Padding="1,0" VerticalAlignment="Center"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 IsVisibleChanged="RenameBox_IsVisibleChanged"
                                                 KeyDown="RenameBox_KeyDown"
                                                 LostFocus="RenameBox_LostFocus"/>
                                    </Grid>
                                    <Button Click="CloseSearchResultsTab_Click" Margin="6,0,0,0"
                                            Width="16" Height="16"
                                            VerticalAlignment="Center" ToolTip="{DynamicResource S.Tab.Close}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="✕"/>
                                                <Setter Property="FontSize" Value="9"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#CC4444"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#AA2222"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Main content: browser view or build editor -->
        <Grid>
            <!-- Browser view (active when no build is open).
                 La Visibility se résout contre le MainViewModel (fenêtre), pas contre le
                 BrowserViewModel local imposé par DataContext — sinon le binding échoue
                 (propriété absente) et retombe à Visible. -->
            <views:BrowserView DataContext="{Binding Browser}"
                               Visibility="{Binding DataContext.IsBrowserActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Search results views (onglets « Résultats N ») : vues empilées dans la même cellule,
                 seule celle de l'onglet actif est visible. Le groupe entier ne s'affiche que dans
                 la vue Résultats. -->
            <ItemsControl ItemsSource="{Binding SearchResultsTabs}"
                          Visibility="{Binding IsSearchResultsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:BrowserView
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Search builder view (onglet Search) — contenu façon PawNed² en cours (B2→B4).
                 DataContext = SearchBuilder → la Visibility passe par RelativeSource (MainViewModel). -->
            <Grid DataContext="{Binding SearchBuilder}" Background="{DynamicResource PanelBackgroundBrush}"
                  Visibility="{Binding DataContext.IsSearchBuilderActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- perso-requête : professions + slots + attributs -->
                    <RowDefinition Height="*"/>     <!-- catalogue (B3) -->
                    <RowDefinition Height="Auto"/>  <!-- barre du bas : périmètres + Lancer la recherche -->
                </Grid.RowDefinitions>
                <!-- Colonne 1 = rail des Mécaniques, comme dans la vue Build : Philippe veut les deux
                     écrans aussi identiques que possible. Il longe le perso-requête ET le catalogue,
                     et s'arrête au-dessus de la barre du bas, seule à passer en ColumnSpan=2.
                     Largeur en Auto pour que le masquage la referme à 0 sans gouttière — ⚠ ne PAS y
                     accrocher de GridSplitter, il y écrirait une largeur en dur. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                      Visibility="{Binding DataContext.ShowMechanicColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="205" MinWidth="70"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                            Background="{DynamicResource ControlBackgroundBrush}"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource S.Cat.Mechanics}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                               Padding="4,2" Background="{DynamicResource HeaderBackgroundBrush}"/>

                    <ListBox Grid.Row="1" Grid.Column="1"
                             ItemsSource="{Binding Catalog.MechanicCategories}"
                             SelectedItem="{Binding Catalog.SelectedMechanicItem}"
                             ItemContainerStyle="{StaticResource CategoryItemStyle}"
                             ItemTemplate="{StaticResource CategoryRowTemplate}"
                             BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Grid>

                <!-- Perso-requête (façon PawNed²) : DataContext = QueryCharacter (CharacterSlotViewModel)
                     → réutilise tels quels les handlers du picker de profession, des slots (drop/drag/
                     molette) et le template d'attributs de l'éditeur. -->
                <Border Grid.Row="0" DataContext="{Binding QueryCharacter}" Background="{DynamicResource ContentBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- professions + slots -->
                            <ColumnDefinition Width="20"/>    <!-- gouttière -->
                            <ColumnDefinition Width="*"/>     <!-- attributs -->
                        </Grid.ColumnDefinitions>

                        <!-- Gauche : professions puis rangée de 8 slots -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <!-- Icône PR — clic gauche = picker (réutilise PrimaryProfIcon_MouseDown) -->
                                <Border Width="28" Height="28" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="14"
                                        Margin="0,0,3,0" Cursor="Hand" ToolTip="{DynamicResource S.Ed.ProfPrimary}"
                                        MouseLeftButtonDown="PrimaryProfIcon_MouseDown">
                                    <Grid>
                                        <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding HasPrimaryProfession, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <Image Source="{Binding PrimaryProfession, Converter={StaticResource ProfToIcon}}"
                                               Width="22" Height="22" Stretch="Uniform"
                                               Visibility="{Binding HasPrimaryProfession, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                                <!-- Icône SEC — clic gauche = picker (réutilise SecondaryProfIcon_MouseDown) -->
                                <Border Width="28" Height="28" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="14"
                                        Margin="0,0,6,0" Cursor="Hand" ToolTip="{DynamicResource S.Ed.ProfSecondary}"
                                        MouseLeftButtonDown="SecondaryProfIcon_MouseDown">
                                    <Grid>
                                        <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding HasSecondaryProfession, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <Image Source="{Binding SecondaryProfession, Converter={StaticResource ProfToIcon}}"
                                               Width="22" Height="22" Stretch="Uniform"
                                               Visibility="{Binding HasSecondaryProfession, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                                <!-- Swap PR/SEC -->
                                <Button Content="⇄" Width="26" Height="26" FontSize="15" Padding="0"
                                        VerticalAlignment="Center" Cursor="Hand"
                                        ToolTip="{DynamicResource S.Ed.SwapProfs}"
                                        Click="QuerySwapProf_Click"
                                        Background="Transparent" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                                <TextBlock Text="{Binding ProfessionDisplay}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- 8 slots — SkillSlotStyle + handlers de l'éditeur (drop/drag/molette) -->
                            <ItemsControl ItemsSource="{Binding SkillSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SkillSlotStyle}"
                                                Width="{Binding DataContext.SlotSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.SlotSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                AllowDrop="True" Focusable="True" FocusVisualStyle="{x:Null}"
                                                ToolTipService.IsEnabled="{Binding HasSkill}"
                                                Drop="SkillSlot_Drop" DragEnter="SkillSlot_DragEnter"
                                                DragOver="SkillSlot_DragOver" DragLeave="SkillSlot_DragLeave"
                                                PreviewMouseLeftButtonDown="SkillSlot_PreviewMouseDown"
                                                PreviewMouseMove="SkillSlot_PreviewMouseMove"
                                                KeyDown="SkillSlot_KeyDown" PreviewMouseWheel="SkillSlot_MouseWheel">
                                            <Border.ToolTip>
                                                <ToolTip Content="{Binding}"
                                                         ContentTemplate="{StaticResource SkillSlotTooltipTemplate}"/>
                                            </Border.ToolTip>
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{DynamicResource S.Ctx.SkillRemove}" Click="ClearSkillSlot_Click"
                                                              IsEnabled="{Binding HasSkill}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <TextBlock Text="?" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource IconMutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasSkill, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                <Image Source="{Binding Skill.IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=64}"
                                                       Width="{Binding DataContext.SlotImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Height="{Binding DataContext.SlotImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Stretch="Uniform" Margin="3"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasSkill, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource S.Ed.DragHint}"
                                       FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="2,5,0,0"/>
                        </StackPanel>

                        <!-- Droite : seuils d'attributs (2 colonnes) -->
                        <Border Grid.Column="2" Grid.IsSharedSizeScope="True"
                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="3"
                                Background="{DynamicResource InsetBackgroundBrush}" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Ed.AttrThresholds}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                <TextBlock Text="{DynamicResource S.Ed.AttrThresholdsHint}"
                                           FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,1,0,5"/>
                                <Grid>
                                    <!-- Deux moitiés ÉGALES et de largeur FIXE, comme l'encart Attributs
                                         de la vue Build : le SharedSizeGroup leur donne à toutes deux la
                                         largeur de la plus large, mesurée sur le contenu. Elles ne
                                         dépendent donc pas de la place disponible, et décocher
                                         « Mechanics » ne les fait pas bouger. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SearchAttrHalf"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SearchAttrHalf"/>
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding PrimaryAttributeRows}" Grid.IsSharedSizeScope="True"
                                                  ItemTemplate="{StaticResource SearchAttributeRowTemplate}" Margin="0,0,6,0"/>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SecondaryAttributeRows}" Grid.IsSharedSizeScope="True"
                                                  ItemTemplate="{StaticResource SearchAttributeRowTemplate}"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Ed.PickProfThresholds}"
                                           FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"
                                           Visibility="{Binding HasPrimaryProfession, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Catalogue de compétences (B3) — réplique du catalogue de l'éditeur, lié à
                     SearchBuilder.Catalog (instance séparée, découplée des PR/SEC du perso-requête).
                     Drag-source vers les slots du perso ci-dessus. Pas de menu contextuel skill ici
                     (ContextMenuSkill retombe sur SkillPanel de l'éditeur → volontairement omis). -->
                <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- onglets d'attributs (pilotés PR/SEC) -->
                            <RowDefinition Height="Auto"/>  <!-- mode PvE/PvP + recherche -->
                            <RowDefinition Height="*"/>     <!-- table -->
                        </Grid.RowDefinitions>

                        <!-- Onglets du catalogue, pilotés par PR/SEC (≡ filtre profession).
                             None/None → un groupe (gras) par profession pour parcourir ; PR/SEC posés
                             → caractéristiques à plat. Ligne 2 (indentée) = sous-onglets du groupe
                             déplié : caractéristiques d'une profession, ou catégories PvE. -->
                        <StackPanel Grid.Row="0" Background="{DynamicResource PanelAltBackgroundBrush}">
                            <ItemsControl ItemsSource="{Binding CatalogTabs}" Margin="4,3,4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CatalogTabStyle}" Tag="{Binding}"
                                                MouseLeftButtonDown="CatalogTab_Click">
                                            <TextBlock Text="{Binding Label}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding CatalogSubTabs}" Margin="18,1,4,3"
                                          Visibility="{Binding ShowSubTabs, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CatalogTabStyle}" Tag="{Binding}"
                                                MouseLeftButtonDown="CatalogSubTab_Click">
                                            <TextBlock Text="{Binding Label}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Filet de séparation entre les onglets de PROFESSION (au-dessus) et les filtres de
                                 catégorie (en dessous) : deux familles qui n'ont rien à voir, et qui se touchaient au
                                 point de se lire comme une seule (demande Philippe 20/08/2026). Il suit la case à
                                 cocher : pas de trait qui pende sous les onglets quand la ligne est masquée. -->
                            <Border Height="1" Margin="4,4,4,3" Background="{DynamicResource BorderLightBrush}"
                                    Visibility="{Binding DataContext.ShowTypeColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <!-- Ligne propre pour « Types » : sa sélection est indépendante des onglets de profession,
                                 donc les deux surlignages coexistent. Visible avec SA case à cocher de la barre de recherche. -->
                            <DockPanel Margin="4,1,4,0"
                                       Visibility="{Binding DataContext.ShowTypeColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <!-- En-tête cliquable : replie/déplie la ligne. Repliée, elle ne montre que le filtre ACTIF. -->
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="86" VerticalAlignment="Top"
                                            Margin="0,4,6,0" Background="Transparent" Cursor="Hand"
                                            Tag="Type" MouseLeftButtonUp="ChipRowHeader_Click"
                                            ToolTip="{DynamicResource S.Cat.ChipRowTip}">
                                    <TextBlock Text="{Binding DataContext.TypeChipsGlyph, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="9" Margin="0,1,3,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{DynamicResource S.Cat.Types}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            
                                <!-- Repliée : le filtre actif, et rien d'autre. -->
                                <TextBlock DockPanel.Dock="Left" FontSize="11" VerticalAlignment="Top" Margin="0,4,0,0"
                                           Text="{Binding Catalog.SelectedTypeItem.DisplayLabel}"
                                           Visibility="{Binding DataContext.TypeChipsExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                            
                                <!-- Dépliée : les 34 puces, sur toute la largeur. Pas de champ de filtre (comme la vue
                                     Build) : à 34 entrées sur deux lignes, il coûtait plus de place qu'il n'en gagnait. -->
                                <ItemsControl ItemsSource="{Binding CatalogTypeTabs}"
                                              Visibility="{Binding DataContext.TypeChipsExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CatalogTabStyle}" Tag="{Binding}"
                                                    MouseLeftButtonDown="CatalogTypeTab_Click">
                                                <TextBlock Text="{Binding Label}" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </StackPanel>

                        <!-- Mode PvE/PvP + recherche par nom -->
                        <StackPanel Grid.Row="1" Margin="6,6,6,4">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Left" Width="100" Margin="0,0,8,0" FontSize="12"
                                          VerticalContentAlignment="Center"
                                          ItemsSource="{Binding Catalog.GameModes}"
                                          SelectedValuePath="Mode"
                                          SelectedValue="{Binding Catalog.SelectedGameMode}"
                                          ToolTip="{DynamicResource S.Ed.GameModeTip}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource S.Ed.SearchSkills}" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Margin="0,0,6,0" FontSize="12"/>
                                <!-- Bascule des deux filtres, SÉPARÉMENT (demande Philippe 20/08/2026) : 34 types et
                                     87 mécaniques n'ont ni le même encombrement ni le même usage. Mêmes booléens que le
                                     menu Affichage ; ils vivent sur MainViewModel, d'où le RelativeSource jusqu'à la
                                     fenêtre quand le DataContext local est celui d'un éditeur. -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                                              IsChecked="{Binding DataContext.ShowTypeColumn, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Content="{DynamicResource S.Cat.Types}"
                                              ToolTip="{DynamicResource S.Cat.ToggleTypesTip}"/>
                                    <CheckBox Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                                              IsChecked="{Binding DataContext.ShowMechanicColumn, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Content="{DynamicResource S.Cat.Mechanics}"
                                              ToolTip="{DynamicResource S.Cat.ToggleMechanicsTip}"/>
                                </StackPanel>
                                <TextBox Text="{Binding Catalog.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12"/>
                            </DockPanel>
                            <!-- Ligne de retour : catégories reconnues dans la saisie + ce que les filtres cachent. -->
                            <TextBlock Style="{StaticResource SearchNoticeStyle}" Tag="{Binding Catalog}"
                                       Text="{Binding Catalog.SearchNotice}"
                                       Visibility="{Binding Catalog.HasSearchNotice, Converter={StaticResource BoolToVisibilityConverter}}"
                                       MouseLeftButtonUp="SearchNotice_Click"/>
                        </StackPanel>

                        <!-- Table des compétences (drag-source vers les slots du perso-requête).
                             Tag=Catalog → SkillListHeader_Click retrouve le bon SkillPanelViewModel. -->
                        <!-- Catalogue de recherche compact (icône + nom), VIRTUALISÉ (défilement
                             vertical) — un WrapPanel casserait la virtualisation et gèlerait sur
                             ~1300 skills. Drag-source vers les slots ; tooltip riche au survol.
                             Tag=Catalog pour les handlers généralisés. -->
                        <ListView x:Name="SearchSkillList" Grid.Row="2" Tag="{Binding Catalog}"
                                  ItemsSource="{Binding Catalog.FilteredSkills}"
                                  SelectedItem="{Binding Catalog.SelectedSkill}"
                                  BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,1,0,0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Standard"
                                  PreviewMouseLeftButtonDown="SkillList_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="SkillList_PreviewMouseMove"
                                  PreviewMouseRightButtonDown="SkillList_PreviewMouseRightButtonDown">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctrl:VirtualizingWrapPanel ItemWidth="{Binding Catalog.CatalogItemWidth}" ItemHeight="28"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <!-- Icône (gauche) + nom (remplit) + mécaniques (droite→gauche).
                                         Mêmes sources/converters que SkillTooltipControl : adrénaline,
                                         énergie, sacrifice, overcast, upkeep, cast, recharge. -->
                                    <DockPanel LastChildFill="True">
                                        <Image DockPanel.Dock="Left"
                                               Source="{Binding IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=24}"
                                               Width="24" Height="24" Stretch="Uniform" Margin="1"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <!-- Mécaniques en COLONNES FIXES : chaque mécanique a sa
                                             colonne réservée → alignement vertical d'une ligne à l'autre
                                             (cellule vide quand la valeur est absente). Ordre : adré,
                                             sacrifice, énergie, overcast, upkeep, cast, recharge. -->
                                        <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Adrénaline -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        Visibility="{Binding Adrenaline, Converter={StaticResource PosInt}}">
                                                <Image Source="{Binding Source='adrenaline', Converter={StaticResource StatIcon}}"
                                                       Width="14" Height="14" Margin="0,0,1,0"/>
                                                <TextBlock Text="{Binding Adrenaline}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Sacrifice -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Visibility="{Binding Sacrifice, Converter={StaticResource PosInt}}">
                                                <Image Source="{Binding Source='mech-sacrifice', Converter={StaticResource StatIcon}}"
                                                       Width="14" Height="14" Margin="0,0,1,0"/>
                                                <TextBlock Text="{Binding Sacrifice, StringFormat={}{0}%}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Énergie -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        Visibility="{Binding EnergyCost, Converter={StaticResource PosInt}}">
                                                <Image Source="{Binding Source='energy', Converter={StaticResource StatIcon}}"
                                                       Width="14" Height="14" Margin="0,0,1,0"/>
                                                <TextBlock Text="{Binding EnergyCost}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Overcast -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        Visibility="{Binding Overcast, Converter={StaticResource PosInt}}">
                                                <Image Source="{Binding Source='mech-overcast', Converter={StaticResource StatIcon}}"
                                                       Width="14" Height="14" Margin="0,0,1,0"/>
                                                <TextBlock Text="{Binding Overcast}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Upkeep -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                        Visibility="{Binding Upkeep, Converter={StaticResource PosInt}}">
                                                <Image Source="{Binding Source='mech-upkeep', Converter={StaticResource StatIcon}}"
                                                       Width="14" Height="14" Margin="0,0,1,0"/>
                                                <TextBlock Text="{Binding Upkeep, StringFormat=-{0}}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Temps de cast -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                        Visibility="{Binding CastTime, Converter={StaticResource PosFloat}}">
                                                <Image Source="{Binding Source='cast', Converter={StaticResource StatIcon}}"
                                                       Width="14" Height="14" Margin="0,0,1,0"/>
                                                <TextBlock Text="{Binding CastTime}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Recharge -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal"
                                                        Visibility="{Binding Recharge, Converter={StaticResource PosFloat}}">
                                                <Image Source="{Binding Source='recharge', Converter={StaticResource StatIcon}}"
                                                       Width="14" Height="14" Margin="0,0,1,0"/>
                                                <TextBlock Text="{Binding Recharge}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="12"
                                                   Margin="4,0,2,0"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource S.Ctx.SkillArticle}" Click="OpenSkillArticle_Click"/>
                                    <MenuItem Header="{DynamicResource S.Ctx.SkillTalk}" Click="OpenSkillDiscussion_Click"/>
                                    <MenuItem Header="{DynamicResource S.Ctx.SkillParse}" Click="ParseSkillInTemplates_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="1"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="ToolTipService.InitialShowDelay" Value="700"/>
                                    <!-- Tooltip PARESSEUX : le SkillTooltipControl (lourd) n'est bâti qu'au 1er
                                         survol via ContentTemplate, pas à la réalisation du container. Sans ça,
                                         le multi-colonnes réalise ~80-95 cellules d'un coup → ~1,2 s de gel. -->
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Content="{Binding}"
                                                     ContentTemplate="{StaticResource CatalogSkillTooltipTemplate}"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsElite}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FFD700"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Barre du bas : titre à gauche, périmètres de recherche + bouton de lancement à droite. -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource PanelAltBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="10,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource S.Search.Title}"
                                   VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Bascule des deux filtres d'AFFICHAGE du catalogue, descendue ici comme
                                 dans la vue Build. ⚠ Les deux cases qui suivent sont d'une tout autre
                                 famille — elles disent OÙ chercher, pas ce qu'on affiche : d'où le
                                 filet vertical qui les sépare. -->
                            <CheckBox Margin="0,0,14,0" VerticalAlignment="Center" FontSize="12"
                                      IsChecked="{Binding DataContext.ShowTypeColumn, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Content="{DynamicResource S.Cat.Types}"
                                      ToolTip="{DynamicResource S.Cat.ToggleTypesTip}"/>
                            <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12"
                                      IsChecked="{Binding DataContext.ShowMechanicColumn, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Content="{DynamicResource S.Cat.Mechanics}"
                                      ToolTip="{DynamicResource S.Cat.ToggleMechanicsTip}"/>
                            <Border Width="1" Margin="0,2,14,2" Background="{DynamicResource BorderLightBrush}"/>
                            <CheckBox Content="Templates (.txt)" VerticalAlignment="Center" Margin="0,0,14,0"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      IsChecked="{Binding SearchInTemplates}"
                                      ToolTip="{DynamicResource S.Search.InclTxtTip}"/>
                            <CheckBox Content="Teambuilds (.pn3 / .pwnd)" VerticalAlignment="Center" Margin="0,0,14,0"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      IsChecked="{Binding SearchInTeamBuilds}"
                                      ToolTip="{DynamicResource S.Search.InclPn3Tip}"/>
                            <Button Content="{DynamicResource S.Search.Run}" Padding="14,4" FontWeight="SemiBold" Cursor="Hand"
                                    Click="RunSearch_Click"
                                    IsEnabled="{Binding CanSearch}"
                                    ToolTip="{Binding SearchDisabledReason}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Calculateur d'armure (onglet Armure, chantier 14). DataContext = ArmorCalc → la
                 Visibility passe par RelativeSource (MainViewModel), comme l'onglet Search. -->
            <views:ArmorCalcView DataContext="{Binding ArmorCalc}"
                                 Visibility="{Binding DataContext.IsArmorCalcActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Build editor views (onglets « Build ») : un éditeur de build simple par onglet,
                 empilés dans la même cellule, seul l'onglet actif est visible. Cloné de l'onglet
                 Search façon PawNed² : perso EN MODE ÉDITEUR (attributs RÉELS, PR obligatoire via
                 isQuery=false) + catalogue à onglets PR/SEC + bouton « Enregistrer le modèle » (.txt).
                 DataContext de chaque item = BuildEditorViewModel. -->
            <ItemsControl ItemsSource="{Binding OpenBuilds}"
                          Visibility="{Binding IsBuildEditorActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="BuildEditorRoot" Background="{DynamicResource PanelBackgroundBrush}"
                              Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- Clic droit n'importe où dans la page (les slots et le catalogue ont
                                 leur propre menu et gardent la priorité) : import d'un template,
                                 comme Édition ▸ Importer un template. PlacementTarget = cette Grid,
                                 dont le DataContext est le BuildEditorViewModel → .Character. -->
                            <Grid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext.Character, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{DynamicResource S.Ctx.CopyO}" InputGestureText="Ctrl+C"
                                              Click="CopyTemplate_Click"/>
                                    <MenuItem Header="{DynamicResource S.Ctx.CopyChat}"
                                              Click="CopyChatCode_Click"/>
                                    <Separator/>
                                    <MenuItem Header="{DynamicResource S.Ctx.ImportClipboard}" InputGestureText="Ctrl+V"
                                              Click="ImportClipboardAny_Click"/>
                                    <MenuItem Header="{DynamicResource S.Ctx.ImportFile}"
                                              Click="ImportFileAny_Click"/>
                                    <Separator/>
                                    <!-- Mêmes vidages qu'au clic droit sur une ligne de teambuild.
                                         Le DataContext du menu EST déjà le perso édité. -->
                                    <MenuItem Header="{DynamicResource S.Ctx.ClearSkills}"
                                              IsEnabled="{Binding HasAnySkill}"
                                              Click="ClearCharSkills_Click"/>
                                    <MenuItem Header="{DynamicResource S.Ctx.ClearAttrs}"
                                              IsEnabled="{Binding HasInvestedAttributes}"
                                              Click="ClearCharAttributes_Click"/>
                                    <MenuItem Header="{DynamicResource S.Ctx.ClearBuild}"
                                              IsEnabled="{Binding HasBuildContent}"
                                              Click="ClearCharBuild_Click"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- perso : professions + slots + attributs réels -->
                                <RowDefinition Height="*"/>     <!-- catalogue -->
                                <RowDefinition Height="Auto"/>  <!-- barre du bas : Enregistrer le modèle -->
                            </Grid.RowDefinitions>
                            <!-- Colonne 1 = rail des Mécaniques (maquette Philippe 20/08/2026). Il longe
                                 le perso ET le catalogue, mais s'arrête AU-DESSUS de la barre du bas :
                                 celle-ci est la seule à passer en ColumnSpan=2, pour que ses boutons
                                 aillent jusqu'au bord droit de l'app et n'y bougent plus jamais.
                                 ⚠ L'encart Attributs, lui, est à CÔTÉ du rail : décocher Mechanics
                                 lui rend la largeur du rail, et ses deux moitiés s'élargissent
                                 d'autant. C'est le rendu voulu par la maquette. Largeur en Auto pour
                                 que le masquage la referme à 0 sans gouttière — ⚠ ne PAS y accrocher
                                 de GridSplitter, il y écrirait une largeur en dur. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                  Visibility="{Binding DataContext.ShowMechanicColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="205" MinWidth="70"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                        Background="{DynamicResource ControlBackgroundBrush}"/>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource S.Cat.Mechanics}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Padding="4,2" Background="{DynamicResource HeaderBackgroundBrush}"/>

                                <ListBox Grid.Row="1" Grid.Column="1"
                                         ItemsSource="{Binding Catalog.MechanicCategories}"
                                         SelectedItem="{Binding Catalog.SelectedMechanicItem}"
                                         ItemContainerStyle="{StaticResource CategoryItemStyle}"
                                         ItemTemplate="{StaticResource CategoryRowTemplate}"
                                         BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </Grid>

                            <!-- Perso édité : DataContext = Character (CharacterSlotViewModel, mode éditeur)
                                 → réutilise tels quels les handlers du picker de profession, des slots
                                 (drop/drag/molette) et le template d'attributs RÉELS de l'éditeur. -->
                            <Border Grid.Row="0" DataContext="{Binding Character}" Background="{DynamicResource ContentBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>  <!-- professions + slots -->
                                        <ColumnDefinition Width="20"/>    <!-- gouttière -->
                                        <ColumnDefinition Width="*"/>     <!-- attributs -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Gauche : professions puis rangée de 8 slots -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <!-- Icône PR — clic gauche = picker (PR obligatoire : None non proposé) -->
                                            <Border Width="28" Height="28" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="14"
                                                    Margin="0,0,3,0" Cursor="Hand" ToolTip="{DynamicResource S.Ed.ProfPrimaryReq}"
                                                    MouseLeftButtonDown="PrimaryProfIcon_MouseDown">
                                                <Grid>
                                                    <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                               Visibility="{Binding HasPrimaryProfession, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                    <Image Source="{Binding PrimaryProfession, Converter={StaticResource ProfToIcon}}"
                                                           Width="22" Height="22" Stretch="Uniform"
                                                           ToolTip="{Binding PrimaryProfessionName}"
                                                           Visibility="{Binding HasPrimaryProfession, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <!-- Icône SEC — clic gauche = picker -->
                                            <Border Width="28" Height="28" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="14"
                                                    Margin="0,0,6,0" Cursor="Hand" ToolTip="{DynamicResource S.Ed.ProfSecondary}"
                                                    MouseLeftButtonDown="SecondaryProfIcon_MouseDown">
                                                <Grid>
                                                    <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                               Visibility="{Binding HasSecondaryProfession, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                    <Image Source="{Binding SecondaryProfession, Converter={StaticResource ProfToIcon}}"
                                                           Width="22" Height="22" Stretch="Uniform"
                                                           ToolTip="{Binding SecondaryProfessionName}"
                                                           Visibility="{Binding HasSecondaryProfession, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <!-- Swap PR/SEC — GARDÉ : désactivé si SEC = None (règle éditeur) -->
                                            <Button Content="⇄" Width="26" Height="26" FontSize="15" Padding="0"
                                                    VerticalAlignment="Center" Cursor="Hand"
                                                    ToolTip="{DynamicResource S.Ed.SwapProfs}"
                                                    Click="BuildSwapProf_Click"
                                                    IsEnabled="{Binding HasSecondaryProfession}"
                                                    Background="Transparent" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                                            <TextBlock Text="{Binding ProfessionDisplay}" VerticalAlignment="Center"
                                                       Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <!-- Indicateur de flux (volatil ici) : DataContext local = Character →
                                                 l'indicateur (sur BuildEditorViewModel) est atteint via ElementName. -->
                                            <Button Click="FluxIcon_Click" Margin="16,0,0,0" VerticalAlignment="Center"
                                                    Padding="4,2" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    DataContext="{Binding DataContext.FluxIndicator, ElementName=BuildEditorRoot}">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="{Binding Tooltip}" TextWrapping="Wrap" MaxWidth="360"/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <Image Source="{Binding IconPath}" Width="20" Height="20" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Opacity" Value="0.35"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Button>
                                        </StackPanel>

                                        <!-- 8 slots — SkillSlotStyle + handlers de l'éditeur (drop/drag/molette) -->
                                        <ItemsControl ItemsSource="{Binding SkillSlots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SkillSlotStyle}"
                                                            Width="{Binding DataContext.SlotSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Height="{Binding DataContext.SlotSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            AllowDrop="True" Focusable="True" FocusVisualStyle="{x:Null}"
                                                            ToolTipService.IsEnabled="{Binding HasSkill}"
                                                            Drop="SkillSlot_Drop" DragEnter="SkillSlot_DragEnter"
                                                            DragOver="SkillSlot_DragOver" DragLeave="SkillSlot_DragLeave"
                                                            PreviewMouseLeftButtonDown="SkillSlot_PreviewMouseDown"
                                                            PreviewMouseMove="SkillSlot_PreviewMouseMove"
                                                            KeyDown="SkillSlot_KeyDown" PreviewMouseWheel="SkillSlot_MouseWheel">
                                                        <Border.ToolTip>
                                                            <ToolTip Content="{Binding}"
                                                                     ContentTemplate="{StaticResource SkillSlotTooltipTemplate}"/>
                                                        </Border.ToolTip>
                                                        <Border.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="{DynamicResource S.Ctx.SkillArticle}" Click="OpenSkillArticle_Click"
                                                                          IsEnabled="{Binding HasSkill}"/>
                                                                <MenuItem Header="{DynamicResource S.Ctx.SkillTalk}" Click="OpenSkillDiscussion_Click"
                                                                          IsEnabled="{Binding HasSkill}"/>
                                                                <MenuItem Header="{DynamicResource S.Ctx.SkillParse}" Click="ParseSkillInTemplates_Click"
                                                                          IsEnabled="{Binding HasSkill}"/>
                                                                <Separator/>
                                                                <MenuItem Header="{DynamicResource S.Ctx.SkillRemove}" Click="ClearSkillSlot_Click"
                                                                          IsEnabled="{Binding HasSkill}"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <TextBlock Text="?" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource IconMutedBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasSkill, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                            <Image Source="{Binding Skill.IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=64}"
                                                                   Width="{Binding DataContext.SlotImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   Height="{Binding DataContext.SlotImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   Stretch="Uniform" Margin="3"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Visibility="{Binding HasSkill, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{DynamicResource S.Ed.DragHint}"
                                                   FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="2,5,0,0"/>
                                        <!-- Bandeau des conditions infligeables. DataContext local = Character
                                             → ConditionBand (sur BuildEditorViewModel) atteint via ElementName
                                             (cf. [[reference_wpf_datacontext_visibility]]) ; toggle menu View. -->
                                        <ContentControl Content="{Binding DataContext.ConditionBand, ElementName=BuildEditorRoot}"
                                                        ContentTemplate="{StaticResource ConditionBandTemplate}"
                                                        Margin="2,6,0,0" Focusable="False"
                                                        Visibility="{Binding DataContext.ShowConditions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <!-- Bandeau des rituels de la nature équipés (indépendant du toggle
                                             conditions ; se masque de lui-même si aucun rituel équipé). -->
                                        <ContentControl Content="{Binding DataContext.NatureRitualBand, ElementName=BuildEditorRoot}"
                                                        ContentTemplate="{StaticResource NatureRitualBandTemplate}"
                                                        Margin="2,4,0,0" Focusable="False"
                                                        Visibility="{Binding DataContext.ShowNatureRituals, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <!-- Toggle « prolongateurs de durée d'enchantement » (Blessed Aura / Extend)
                                             du perso édité — visible seulement s'il en porte un. Ambre = actif.
                                             DataContext local = Character → binding direct. -->
                                        <StackPanel Orientation="Horizontal" Margin="2,4,0,0"
                                                    Visibility="{Binding HasDurationBooster, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="14" Cursor="Hand"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource RitualVariableBrush}"
                                                       ToolTip="{DynamicResource S.Row.BoostersOnTip}"
                                                       MouseLeftButtonUp="DurationBoosters_Click"
                                                       Visibility="{Binding DurationBoostersEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="14" Cursor="Hand"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource IconMutedBrush}"
                                                       ToolTip="{DynamicResource S.Row.BoostersOffTip}"
                                                       MouseLeftButtonUp="DurationBoosters_Click"
                                                       Visibility="{Binding DurationBoostersEnabled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                            <TextBlock Text="{DynamicResource S.Row.Boosters}" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <!-- Bandeau local des boosts d'attribut (Lot A) — DataContext
                                             local = Character → binding direct, comme ci-dessus. -->
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AttributeBoostBandTemplate}"
                                                        Margin="2,4,0,0" Focusable="False"/>
                                    </StackPanel>

                                    <!-- Droite : attributs RÉELS (mêmes templates AttributeRowTemplate + handlers
                                         spinner/molette que l'éditeur de teambuild) — budget 200, mod « of the
                                         profession », rangs de titre. -->
                                    <Border Grid.Column="2" Grid.IsSharedSizeScope="True"
                                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="3"
                                            Background="{DynamicResource InsetBackgroundBrush}" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource S.Ed.Attributes}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <!-- Deux moitiés ÉGALES et de largeur FIXE (Philippe, 20/08/2026), sans
                                                         aucun nombre en dur : les deux colonnes partagent un SharedSizeGroup,
                                                         donc elles prennent toutes deux la largeur de la PLUS LARGE des deux,
                                                         mesurée sur leur contenu. Trois propriétés d'un coup —
                                                           · elles sont égales, le séparateur tombe au milieu ;
                                                           · elles ne dépendent PAS de la place disponible, donc décocher
                                                             « Mechanics » ne les fait plus bouger d'un pixel ;
                                                           · rien à deviner ni à maintenir si un libellé change de longueur.
                                                         ⚠ La portée de CE partage est le Border parent ; celle du nom de
                                                         caractéristique est posée plus bas, sur chaque bloc — un groupe se
                                                         résout toujours sur la portée la plus proche, les deux ne se
                                                         mélangent donc pas. -->
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorAttrHalf"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorAttrHalf"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Compteur de points investis (rouge/gras si > 200) -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6">
                                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOverAttributeBudget}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding TotalAttributePoints, Mode=OneWay}"/><Run Text="/200"/>
                                                    </TextBlock>
                                                    <TextBlock Text="attr pts" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- Attributs profession primaire -->
                                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,1,0" Margin="2,0"
                                                        Grid.IsSharedSizeScope="True">
                                                    <!-- 6 px de part et d'autre du trait de séparation (c'était 4 d'un côté
                                                         et 8 de l'autre : 2 de marge du Border + 6 du bloc secondaire). -->
                                                    <ItemsControl ItemsSource="{Binding PrimaryAttributeRows}"
                                                                  ItemTemplate="{StaticResource EditorAttributeRowTemplate}" Margin="4,2,6,2"/>
                                                </Border>
                                                <!-- Attributs profession secondaire -->
                                                <ItemsControl Grid.Column="2" ItemsSource="{Binding SecondaryAttributeRows}"
                                                              Grid.IsSharedSizeScope="True"
                                                              ItemTemplate="{StaticResource EditorAttributeRowTemplate}" Margin="4,2,4,2"/>
                                            </Grid>
                                            <!-- Mod « of the profession » : force la carac primaire de la profession choisie à 5 -->
                                            <StackPanel Orientation="Horizontal" Margin="72,0,4,4">
                                                <CheckBox Content="mod of the" VerticalAlignment="Center"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          IsChecked="{Binding OfProfessionModEnabled}"/>
                                                <ComboBox Width="120" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          ItemsSource="{Binding ModProfessions}"
                                                          SelectedItem="{Binding OfProfessionModProfession}"
                                                          IsEnabled="{Binding OfProfessionModEnabled}"/>
                                            </StackPanel>
                                            <!-- Rangs de titre PvE (hors budget) — uniquement les pistes utilisées -->
                                            <StackPanel Margin="72,0,4,6"
                                                        Visibility="{Binding HasTitleRanks, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource S.Ed.TitleRanks}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,1"/>
                                                <ItemsControl ItemsSource="{Binding TitleRankRows}" Grid.IsSharedSizeScope="True"
                                                              ItemTemplate="{StaticResource EditorAttributeRowTemplate}"/>
                                            </StackPanel>
                                            <TextBlock Text="{DynamicResource S.Ed.PickProfAttrs}"
                                                       FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"
                                                       Visibility="{Binding HasPrimaryProfession, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Catalogue de compétences (façon PawNed²) — lié à Catalog (instance dédiée),
                                 drag-source vers les slots ci-dessus. Onglets pilotés par PR/SEC. -->
                            <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>  <!-- onglets (pilotés PR/SEC) -->
                                        <RowDefinition Height="Auto"/>  <!-- mode PvE/PvP + recherche par nom -->
                                        <RowDefinition Height="*"/>     <!-- table -->
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Background="{DynamicResource PanelAltBackgroundBrush}">
                                        <ItemsControl ItemsSource="{Binding CatalogTabs}" Margin="4,3,4,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CatalogTabStyle}" Tag="{Binding}"
                                                            MouseLeftButtonDown="BuildCatalogTab_Click">
                                                        <TextBlock Text="{Binding Label}" FontSize="11"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding CatalogSubTabs}" Margin="18,1,4,3"
                                                      Visibility="{Binding ShowSubTabs, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CatalogTabStyle}" Tag="{Binding}"
                                                            MouseLeftButtonDown="BuildCatalogSubTab_Click">
                                                        <TextBlock Text="{Binding Label}" FontSize="11"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Filet de séparation entre les onglets de PROFESSION (au-dessus) et les filtres de
                                             catégorie (en dessous) : deux familles qui n'ont rien à voir, et qui se touchaient au
                                             point de se lire comme une seule (demande Philippe 20/08/2026). Il suit la case à
                                             cocher : pas de trait qui pende sous les onglets quand la ligne est masquée. -->
                                        <Border Height="1" Margin="4,4,4,3" Background="{DynamicResource BorderLightBrush}"
                                                Visibility="{Binding DataContext.ShowTypeColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <!-- Ligne propre pour « Types » : sa sélection est indépendante des onglets de profession,
                                             donc les deux surlignages coexistent. Visible avec SA case à cocher de la barre de recherche. -->
                                        <DockPanel Margin="4,1,4,0"
                                                   Visibility="{Binding DataContext.ShowTypeColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <!-- En-tête cliquable : replie/déplie la ligne. Repliée, elle ne montre que le filtre ACTIF. -->
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="86" VerticalAlignment="Top"
                                                        Margin="0,4,6,0" Background="Transparent" Cursor="Hand"
                                                        Tag="Type" MouseLeftButtonUp="ChipRowHeader_Click"
                                                        ToolTip="{DynamicResource S.Cat.ChipRowTip}">
                                                <TextBlock Text="{Binding DataContext.TypeChipsGlyph, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="9" Margin="0,1,3,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{DynamicResource S.Cat.Types}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        
                                            <!-- Repliée : le filtre actif, et rien d'autre. -->
                                            <TextBlock DockPanel.Dock="Left" FontSize="11" VerticalAlignment="Top" Margin="0,4,0,0"
                                                       Text="{Binding Catalog.SelectedTypeItem.DisplayLabel}"
                                                       Visibility="{Binding DataContext.TypeChipsExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        
                                            <!-- Dépliée : les 34 puces, sur toute la largeur. Pas de champ de filtre ici (maquette
                                                 Philippe 20/08/2026) : à 34 entrées sur deux lignes, il coûtait plus de place qu'il
                                                 n'en faisait gagner. L'écran Recherche, lui, garde le sien. -->
                                            <ItemsControl ItemsSource="{Binding CatalogTypeTabs}"
                                                          Visibility="{Binding DataContext.TypeChipsExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource CatalogTabStyle}" Tag="{Binding}"
                                                                MouseLeftButtonDown="BuildCatalogTypeTab_Click">
                                                            <TextBlock Text="{Binding Label}" FontSize="11"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Mode PvE/PvP + recherche par nom -->
                                    <StackPanel Grid.Row="1" Margin="6,6,6,4">
                                        <DockPanel>
                                            <ComboBox DockPanel.Dock="Left" Width="100" Margin="0,0,8,0" FontSize="12"
                                                      VerticalContentAlignment="Center"
                                                      ItemsSource="{Binding Catalog.GameModes}"
                                                      SelectedValuePath="Mode"
                                                      SelectedValue="{Binding Catalog.SelectedGameMode}"
                                                      ToolTip="{DynamicResource S.Ed.GameModeTip}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="{DynamicResource S.Ed.SearchSkills}" DockPanel.Dock="Left" VerticalAlignment="Center"
                                                       Margin="0,0,6,0" FontSize="12"/>
                                            <TextBox Text="{Binding Catalog.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12"/>
                                        </DockPanel>
                                        <!-- Ligne de retour : catégories reconnues dans la saisie + ce que les filtres cachent. -->
                                        <TextBlock Style="{StaticResource SearchNoticeStyle}" Tag="{Binding Catalog}"
                                                   Text="{Binding Catalog.SearchNotice}"
                                                   Visibility="{Binding Catalog.HasSearchNotice, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   MouseLeftButtonUp="SearchNotice_Click"/>
                                    </StackPanel>

                                    <!-- Table des compétences (drag-source). Tag=Catalog → handlers généralisés. -->
                                    <ListView Grid.Row="2" Tag="{Binding Catalog}"
                                              ItemsSource="{Binding Catalog.FilteredSkills}"
                                              SelectedItem="{Binding Catalog.SelectedSkill}"
                                              BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,1,0,0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                              ScrollViewer.CanContentScroll="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Standard"
                                              PreviewMouseLeftButtonDown="SkillList_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="SkillList_PreviewMouseMove"
                                              PreviewMouseRightButtonDown="SkillList_PreviewMouseRightButtonDown">
                                        <ListView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource S.Ctx.SkillArticle}" Click="OpenSkillArticle_Click"/>
                                                <MenuItem Header="{DynamicResource S.Ctx.SkillTalk}" Click="OpenSkillDiscussion_Click"/>
                                                <MenuItem Header="{DynamicResource S.Ctx.SkillParse}" Click="ParseSkillInTemplates_Click"/>
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ctrl:VirtualizingWrapPanel ItemWidth="{Binding Catalog.CatalogItemWidth}" ItemHeight="28"/>
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <Image DockPanel.Dock="Left"
                                                           Source="{Binding IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=24}"
                                                           Width="24" Height="24" Stretch="Uniform" Margin="1"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,4,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="32"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    Visibility="{Binding Adrenaline, Converter={StaticResource PosInt}}">
                                                            <Image Source="{Binding Source='adrenaline', Converter={StaticResource StatIcon}}"
                                                                   Width="14" Height="14" Margin="0,0,1,0"/>
                                                            <TextBlock Text="{Binding Adrenaline}" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    Visibility="{Binding Sacrifice, Converter={StaticResource PosInt}}">
                                                            <Image Source="{Binding Source='mech-sacrifice', Converter={StaticResource StatIcon}}"
                                                                   Width="14" Height="14" Margin="0,0,1,0"/>
                                                            <TextBlock Text="{Binding Sacrifice, StringFormat={}{0}%}" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    Visibility="{Binding EnergyCost, Converter={StaticResource PosInt}}">
                                                            <Image Source="{Binding Source='energy', Converter={StaticResource StatIcon}}"
                                                                   Width="14" Height="14" Margin="0,0,1,0"/>
                                                            <TextBlock Text="{Binding EnergyCost}" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                    Visibility="{Binding Overcast, Converter={StaticResource PosInt}}">
                                                            <Image Source="{Binding Source='mech-overcast', Converter={StaticResource StatIcon}}"
                                                                   Width="14" Height="14" Margin="0,0,1,0"/>
                                                            <TextBlock Text="{Binding Overcast}" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                                    Visibility="{Binding Upkeep, Converter={StaticResource PosInt}}">
                                                            <Image Source="{Binding Source='mech-upkeep', Converter={StaticResource StatIcon}}"
                                                                   Width="14" Height="14" Margin="0,0,1,0"/>
                                                            <TextBlock Text="{Binding Upkeep, StringFormat=-{0}}" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                                    Visibility="{Binding CastTime, Converter={StaticResource PosFloat}}">
                                                            <Image Source="{Binding Source='cast', Converter={StaticResource StatIcon}}"
                                                                   Width="14" Height="14" Margin="0,0,1,0"/>
                                                            <TextBlock Text="{Binding CastTime}" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="6" Orientation="Horizontal"
                                                                    Visibility="{Binding Recharge, Converter={StaticResource PosFloat}}">
                                                            <Image Source="{Binding Source='recharge', Converter={StaticResource StatIcon}}"
                                                                   Width="14" Height="14" Margin="0,0,1,0"/>
                                                            <TextBlock Text="{Binding Recharge}" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="12"
                                                               Margin="4,0,2,0"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="1"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="ToolTipService.InitialShowDelay" Value="700"/>
                                                <Setter Property="ToolTip">
                                                    <Setter.Value>
                                                        <ToolTip Content="{Binding}"
                                                                 ContentTemplate="{StaticResource CatalogSkillTooltipTemplate}"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsElite}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FFD700"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- Barre du bas : titre à gauche, boutons Copier le code / Copier le code de chat / Enregistrer le modèle à droite. -->
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource PanelAltBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="10,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <!-- Bascule des deux filtres, SÉPARÉMENT. Elles vivaient dans la barre de recherche
                                             du catalogue ; Philippe les a descendues ici (20/08/2026), à gauche des boutons
                                             de sortie. Mêmes booléens que le menu Affichage, portés par MainViewModel —
                                             d'où le RelativeSource jusqu'à la fenêtre, le DataContext local étant l'éditeur. -->
                                        <CheckBox Margin="0,0,14,0" VerticalAlignment="Center" FontSize="12"
                                                  IsChecked="{Binding DataContext.ShowTypeColumn, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Content="{DynamicResource S.Cat.Types}"
                                                  ToolTip="{DynamicResource S.Cat.ToggleTypesTip}"/>
                                        <CheckBox Margin="0,0,20,0" VerticalAlignment="Center" FontSize="12"
                                                  IsChecked="{Binding DataContext.ShowMechanicColumn, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Content="{DynamicResource S.Cat.Mechanics}"
                                                  ToolTip="{DynamicResource S.Cat.ToggleMechanicsTip}"/>
                                        <Button Content="{DynamicResource S.Ed.CopyCode}" Padding="14,4" FontWeight="SemiBold" Cursor="Hand"
                                                Margin="0,0,8,0"
                                                Click="CopyBuildCode_Click"
                                                ToolTip="{DynamicResource S.Ed.CopyCodeTip}"/>
                                        <Button Content="{DynamicResource S.Ed.CopyChat}" Padding="14,4" FontWeight="SemiBold" Cursor="Hand"
                                                Margin="0,0,8,0"
                                                Click="CopyBuildChatCode_Click"
                                                ToolTip="{DynamicResource S.Ed.CopyChatTip}"/>
                                        <Button Content="{DynamicResource S.Ed.SaveTpl}" Padding="14,4" FontWeight="SemiBold" Cursor="Hand"
                                                Click="SaveBuild_Click"
                                                ToolTip="{DynamicResource S.Ed.SaveTplTip}"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource S.Ed.SaveAsTxt}"
                                               VerticalAlignment="Center"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Build editor (active when a build tab is selected) -->
            <Grid Visibility="{Binding IsTeamBuildActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>
            <!-- Rangée 1 = barre d'actions, sur TOUTE la largeur (maquette Philippe 20/08/2026).
                 Elle était une rangée de la seule colonne de gauche et s'arrêtait donc au splitter ;
                 elle court maintenant sous la grille ET sous le catalogue, comme la barre du bas des
                 vues Build et Recherche. Ses deux cases de filtre se retrouvent ainsi au vrai bord
                 droit de la fenêtre, et le splitter vertical ne les déplace plus. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left: Team build grid -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- ligne de conditions (tout le teambuild) -->
                    <RowDefinition Height="Auto"/>  <!-- bandeau cadenas (mode sélection) -->
                    <RowDefinition Height="*"/>     <!-- grille des personnages -->
                </Grid.RowDefinitions>

                <!-- Ligne UNIQUE des conditions infligeables par le teambuild (agrégat des persos
                     racine) : couleur = un perso l'inflige, grisée = un combo le pourrait.
                     Toggle : menu View > Afficher les conditions. -->
                <StackPanel Grid.Row="0">
                    <Border Background="{DynamicResource ContentBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1"
                            Padding="8,4"
                            Visibility="{Binding ShowConditions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource S.Ed.ConditionsLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ContentControl Content="{Binding TeamConditionBand}"
                                            ContentTemplate="{StaticResource ConditionBandTemplate}"
                                            Focusable="False" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Bandeau des rituels de la nature équipés : indépendant du toggle « conditions »,
                         se masque de lui-même (HasItems) si aucun rituel n'est équipé. -->
                    <Border Background="{DynamicResource ContentBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <!-- Visible seulement si le toggle « Afficher la barre » est actif ET qu'il y a des items. -->
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                <Binding Path="ShowNatureRituals"/>
                                <Binding Path="TeamNatureRitualBand.HasItems"/>
                            </MultiBinding>
                        </Border.Visibility>
                        <ContentControl Content="{Binding TeamNatureRitualBand}"
                                        ContentTemplate="{StaticResource NatureRitualBandTemplate}"
                                        Focusable="False" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Bandeau de verrouillage de cadenas (mode sélection) -->
                <Border Grid.Row="1" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="0,0,0,1"
                        Padding="8,5"
                        Visibility="{Binding ActiveTeamBuild.IsLockSelectionMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource S.Tb2.LockCancel}" Padding="8,2" Margin="4,0,0,0"
                                Click="CancelLock_Click"/>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource S.Tb2.LockConfirm}" Padding="8,2"
                                Click="ConfirmLock_Click"/>
                        <TextBlock Text="{Binding ActiveTeamBuild.LockSelectionPrompt}"
                                   VerticalAlignment="Center" FontSize="11"/>
                    </DockPanel>
                </Border>

                <!-- PreviewMouseWheel : premier informé de CHAQUE cran passant dans la grille, avant
                     les slots et les lignes d'attributs. C'est le point de passage unique sur lequel
                     repose l'arbitrage « défiler ou régler » (cf. WheelMayAdjust). -->
                <ScrollViewer x:Name="TeamScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="TeamScroll_PreviewMouseWheel"
                              HorizontalScrollBarVisibility="Auto" Background="{DynamicResource ContentBackgroundBrush}">
                    <ItemsControl x:Name="CharacterGrid"
                                  ItemsSource="{Binding ActiveTeamBuild.VisibleRows}"
                                  ItemTemplate="{StaticResource CharacterSlotTemplate}"
                                  Margin="4"/>
                </ScrollViewer>

            </Grid>

            <!-- Barre d'actions unifiée : filtres cadenas (gauche) + boutons d'action (droite) -->
            <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False" Margin="8,6">
                    <!-- Boutons d'action (droite) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⚡ Spike" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center"
                                Click="SpikeCalc_Click"
                                ToolTip="{DynamicResource S.Tb2.SpikeTip}"/>
                        <CheckBox Content="{DynamicResource S.Tb2.Barred}" VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="{DynamicResource S.Tb2.BarredTip}"
                                  IsChecked="{Binding ActiveTeamBuild.ShowInheritedAsBarred}"/>
                        <CheckBox Content="{DynamicResource S.Tb2.ShowAttrs}" VerticalAlignment="Center"
                                  IsChecked="{Binding ActiveTeamBuild.ShowAttributes}"/>
                        <!-- Indicateur de flux : grisé = inactif (flux du mois), coloré = actif.
                             Clic = activer/désactiver ; choix d'un autre flux via menu Sélection > Flux. -->
                        <Button Click="FluxIcon_Click" Margin="16,0,0,0" VerticalAlignment="Center"
                                Padding="4,2" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                DataContext="{Binding ActiveTeamBuild.FluxIndicator}">
                            <Button.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="{Binding Tooltip}" TextWrapping="Wrap" MaxWidth="360"/>
                                </ToolTip>
                            </Button.ToolTip>
                            <Image Source="{Binding IconPath}" Width="20" Height="20" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Opacity" Value="0.35"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Button>

                        <!-- Bascule des deux filtres du CATALOGUE (maquette Philippe 20/08/2026).
                             Elles vivaient dans la barre de recherche du catalogue ; elles sont
                             descendues ici, tout à droite, comme dans les vues Build et Recherche —
                             les trois écrans se ressemblent le plus possible. ⚠ Ce qui précède
                             (« Compétences héritées », « Afficher les caractéristiques ») pilote
                             l'affichage de la GRILLE, pas le catalogue : d'où le filet qui sépare
                             les deux familles, comme dans la barre du bas de la Recherche.
                             DataContext local = MainViewModel, donc binding direct. -->
                        <Border Width="1" Margin="16,2,14,2" Background="{DynamicResource BorderLightBrush}"/>
                        <CheckBox Margin="0,0,12,0" VerticalAlignment="Center"
                                  IsChecked="{Binding ShowTypeColumn}"
                                  Content="{DynamicResource S.Cat.Types}"
                                  ToolTip="{DynamicResource S.Cat.ToggleTypesTip}"/>
                        <CheckBox VerticalAlignment="Center"
                                  IsChecked="{Binding ShowMechanicColumn}"
                                  Content="{DynamicResource S.Cat.Mechanics}"
                                  ToolTip="{DynamicResource S.Cat.ToggleMechanicsTip}"/>
                    </StackPanel>

                    <!-- Filtres par cadenas (gauche) : 1 bouton par cadenas + retour à la vue complète -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ActiveTeamBuild.HasLocks, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource S.Tb2.LocksLabel}" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="{DynamicResource S.Tb2.FullView}" Padding="8,2" Click="ShowAllLocks_Click"
                                FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding ActiveTeamBuild.Locks}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Click="FilterByLock_Click" Margin="6,0,0,0"
                                            Padding="8,2" Foreground="White" BorderThickness="0"
                                            Background="{Binding ColorBrush}" ToolTip="{Binding MembersTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Index}" FontWeight="Bold" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource ControlBackgroundBrush}"/>

            <!-- Right: Skill panel -->
            <Grid Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="220" MinHeight="80"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Colonne 1 = rail des Mécaniques, sur TOUTE la hauteur (idée Philippe
                     20/08/2026) : il prend la place que la table laissait vide à sa droite, et sort
                     les 87 mécaniques du bandeau de 220 px où l'on n'en voyait qu'une dizaine.
                     Largeur en Auto pour que le masquage la referme à 0 sans gouttière — ne PAS y
                     accrocher de GridSplitter, il y écrirait une largeur en dur (cf. le bloc Types). -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Splitter haut / bas -->
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" Background="{DynamicResource ControlBackgroundBrush}"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

                <!-- Professions | Caractéristiques | PvE only -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Largeurs par défaut calées sur les proportions observées en usage réel (fixes,
                         ajustables via les GridSplitter) : Professions < Caractéristiques < PvE only,
                         ce dernier devant loger les intitulés de catégorie sans les tronquer. -->
                    <!-- Professions et Caractéristiques resserrées (150→130, 160→145) pour faire de
                         la place aux colonnes Skill Types/Mechanics, qui occupent la 6e colonne
                         (Auto → 0 quand le bloc est masqué). -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" MinWidth="70"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="145" MinWidth="70"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="220" MinWidth="70"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- En-têtes -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource S.Cat.Professions}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                               Padding="4,2" Background="{DynamicResource HeaderBackgroundBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource S.Cat.Attributes}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                               Padding="4,2" Background="{DynamicResource HeaderBackgroundBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="PvE only"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                               Padding="4,2" Background="{DynamicResource HeaderBackgroundBrush}"/>

                    <!-- Profession list. ⚠ Elle avait son propre ItemContainerStyle (Padding 6,3 /
                         FontSize 13) la ou ses trois voisines partagent AttributeItemStyle
                         (Padding 4,2 / FontSize 12) : une police un point plus grosse et 2 px
                         d'interligne en trop, plus 2 px encore ajoutes par un Padding sur le
                         TextBlock lui-meme. Les quatre colonnes sont alignees depuis le
                         21/08/2026 (Philippe). -->
                    <ListBox Grid.Row="1" Grid.Column="0"
                             ItemsSource="{Binding SkillPanel.Professions}"
                             SelectedItem="{Binding SkillPanel.SelectedProfessionOption}"
                             ItemContainerStyle="{StaticResource AttributeItemStyle}"
                             BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- Entrée méta "All professions" (Value == null) : même poids que les
                                                     autres en-têtes (umbrellas PvE) → SemiBold. -->
                                                <DataTrigger Binding="{Binding Value}" Value="{x:Null}">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Splitter professions / caractéristiques -->
                    <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource ControlBackgroundBrush}" ResizeBehavior="PreviousAndNext"/>

                    <!-- Caractéristiques de la profession -->
                    <ListBox Grid.Row="1" Grid.Column="2"
                             ItemsSource="{Binding SkillPanel.ProfessionAttributes}"
                             SelectedItem="{Binding SkillPanel.SelectedProfessionAttribute}"
                             ItemContainerStyle="{StaticResource AttributeItemStyle}"
                             BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Texte = clé EN traduite à l'affichage ; le DataTrigger reste sur la clé EN. -->
                                <TextBlock Text="{Binding Converter={StaticResource AttrDisplay}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- Entrée méta "All attributes" : même poids que les autres en-têtes → SemiBold. -->
                                                <DataTrigger Binding="{Binding}" Value="All attributes">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Splitter caractéristiques / PvE only -->
                    <GridSplitter Grid.Row="1" Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource ControlBackgroundBrush}" ResizeBehavior="PreviousAndNext"/>

                    <!-- Panneau PvE-only skills (umbrellas campagne en gras, sous-catégories indentées) -->
                    <ListBox Grid.Row="1" Grid.Column="4"
                             ItemsSource="{Binding SkillPanel.PveCategories}"
                             SelectedItem="{Binding SkillPanel.SelectedPveItem}"
                             ItemContainerStyle="{StaticResource AttributeItemStyle}"
                             BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayLabel}" Margin="{Binding Margin}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Indent}" Value="0">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bloc « Skill Types » (case à cocher de la barre de recherche = menu
                         Affichage). Un bloc à part, et non une colonne du Grid parent : sa colonne
                         hôte est en Auto, donc masquer le bloc la referme à 0 sans laisser de
                         gouttière — et aucun GridSplitter ne doit toucher cette colonne, sous peine
                         de lui écrire une largeur en dur qui casserait la mécanique.
                         ⚠ Les MÉCANIQUES ne sont plus ici : ce bandeau est bloqué à 220 px de haut,
                         ce qui n'en montrait qu'une dizaine sur 87. Elles sont passées dans le rail
                         de droite, pleine hauteur (demande Philippe 20/08/2026). Les deux filtres
                         restent INDÉPENDANTS : leur croisement est le but, et chacun a sa case. -->
                    <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="5"
                          Visibility="{Binding ShowTypeColumn, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="205" MinWidth="70"/>
                        </Grid.ColumnDefinitions>

                        <!-- Séparation avec « PvE only » : même couleur que les splitters voisins
                             mais 8 px au lieu de 4 (demande Philippe), et non draggable. -->
                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                Background="{DynamicResource ControlBackgroundBrush}"/>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource S.Cat.Types}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Padding="4,2" Background="{DynamicResource HeaderBackgroundBrush}"/>

                        <ListBox Grid.Row="1" Grid.Column="1"
                                 ItemsSource="{Binding SkillPanel.TypeCategories}"
                                 SelectedItem="{Binding SkillPanel.SelectedTypeItem}"
                                 ItemContainerStyle="{StaticResource CategoryItemStyle}"
                                 ItemTemplate="{StaticResource CategoryRowTemplate}"
                                 BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </Grid>

                <!-- Mode PvE/PvP + Search + bascule des colonnes Skill Types/Mechanics + ligne de retour -->
                <StackPanel Grid.Row="2" Margin="6,6,6,4">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Left" Width="100" Margin="0,0,8,0" FontSize="12"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding SkillPanel.GameModes}"
                                  SelectedValuePath="Mode"
                                  SelectedValue="{Binding SkillPanel.SelectedGameMode}"
                                  ToolTip="{DynamicResource S.Ed.GameModeTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource S.Ed.SearchSkills}" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Margin="0,0,6,0" FontSize="12"/>
                        <TextBox Text="{Binding SkillPanel.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12"/>
                    </DockPanel>
                    <!-- Ligne de retour : ce que la saisie a été comprise comme catégorie, et combien
                         de compétences les filtres profession/caractéristique cachent. Le clic les lève. -->
                    <TextBlock Style="{StaticResource SearchNoticeStyle}" Tag="{Binding SkillPanel}"
                               Text="{Binding SkillPanel.SearchNotice}"
                               Visibility="{Binding SkillPanel.HasSearchNotice, Converter={StaticResource BoolToVisibilityConverter}}"
                               MouseLeftButtonUp="SearchNotice_Click"/>
                </StackPanel>


                <!-- Rail des Mécaniques : mêmes ItemsSource/SelectedItem que la colonne d'avant,
                     seule la place change. Il longe le bandeau, la barre de recherche ET la table. -->
                <Grid Grid.Row="0" Grid.RowSpan="4" Grid.Column="1"
                      Visibility="{Binding ShowMechanicColumn, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="205" MinWidth="70"/>
                    </Grid.ColumnDefinitions>

                    <!-- Séparation avec la table : 8 px, même couleur que les splitters voisins. -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                            Background="{DynamicResource ControlBackgroundBrush}"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource S.Cat.Mechanics}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                               Padding="4,2" Background="{DynamicResource HeaderBackgroundBrush}"/>

                    <ListBox Grid.Row="1" Grid.Column="1"
                             ItemsSource="{Binding SkillPanel.MechanicCategories}"
                             SelectedItem="{Binding SkillPanel.SelectedMechanicItem}"
                             ItemContainerStyle="{StaticResource CategoryItemStyle}"
                             ItemTemplate="{StaticResource CategoryRowTemplate}"
                             BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
                <!-- Skill list (ListView+GridView pour alignement automatique des colonnes) -->
                <ListView x:Name="SkillList" Grid.Row="3" Tag="{Binding SkillPanel}"
                          ItemsSource="{Binding SkillPanel.FilteredSkills}"
                          SelectedItem="{Binding SkillPanel.SelectedSkill}"
                          GridViewColumnHeader.Click="SkillListHeader_Click"
                          BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,1,0,0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          SizeChanged="SkillList_SizeChanged"
                          PreviewMouseLeftButtonDown="SkillList_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="SkillList_PreviewMouseMove">
                    <ListView.View>
                        <GridView>
                            <!-- Icône (redimensionnable via bord droit de l'en-tête).
                                 Largeur ≥ ListIconSize (64) sinon l'icône est rognée à droite. -->
                            <GridViewColumn Width="74">
                                <GridViewColumnHeader Content=""/>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=64}"
                                               Width="{Binding DataContext.ListIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Height="{Binding DataContext.ListIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Nom -->
                            <GridViewColumn x:Name="SkillNameColumn" Header="{DynamicResource S.Cat.Name}" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Énergie -->
                            <GridViewColumn Header="E" Width="{Binding DataContext.SkillPanel.EnergyColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Energy cost"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding EnergyCost, Converter={StaticResource PosInt}}">
                                            <Image Source="{Binding Converter={StaticResource StatIcon}, ConverterParameter=mech-energy}"
                                                   Width="14" Height="14" Margin="0,0,2,0"/>
                                            <TextBlock Text="{Binding EnergyCost}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Adrénaline (vide si 0) -->
                            <GridViewColumn Header="A" Width="{Binding DataContext.SkillPanel.AdrenalineColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Adrenaline"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding Adrenaline, Converter={StaticResource PosInt}}">
                                            <Image Source="{Binding Converter={StaticResource StatIcon}, ConverterParameter=mech-adrenaline}"
                                                   Width="14" Height="14" Margin="0,0,2,0"/>
                                            <TextBlock Text="{Binding Adrenaline}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Sacrifice (% de vie max, vide si 0) -->
                            <GridViewColumn Header="S" Width="{Binding DataContext.SkillPanel.SacrificeColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Health sacrifice"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding Sacrifice, Converter={StaticResource PosInt}}">
                                            <Image Source="{Binding Converter={StaticResource StatIcon}, ConverterParameter=mech-sacrifice}"
                                                   Width="14" Height="14" Margin="0,0,2,0"/>
                                            <TextBlock Text="{Binding Sacrifice, ConverterParameter=%, Converter={StaticResource ZeroBlank}}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Overcast (énergie additionnelle si attribut overcast, vide si 0) -->
                            <GridViewColumn Header="O" Width="{Binding DataContext.SkillPanel.OvercastColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Overcast"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding Overcast, Converter={StaticResource PosInt}}">
                                            <Image Source="{Binding Converter={StaticResource StatIcon}, ConverterParameter=mech-overcast}"
                                                   Width="14" Height="14" Margin="0,0,2,0"/>
                                            <TextBlock Text="{Binding Overcast}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Upkeep (dégénération continue, vide si 0) -->
                            <GridViewColumn Header="U" Width="{Binding DataContext.SkillPanel.UpkeepColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Upkeep"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding Upkeep, Converter={StaticResource PosInt}}">
                                            <Image Source="{Binding Converter={StaticResource StatIcon}, ConverterParameter=mech-upkeep}"
                                                   Width="14" Height="14" Margin="0,0,2,0"/>
                                            <!-- Upkeep stocké en magnitude positive ; affiché "-1" (pip d'énergie). -->
                                            <TextBlock Text="{Binding Upkeep, StringFormat=-{0}}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Activation (temps de cast) -->
                            <GridViewColumn Header="C" Width="{Binding DataContext.SkillPanel.CastColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Activation time"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding CastTime, Converter={StaticResource PosFloat}}">
                                            <Image Source="{Binding Converter={StaticResource StatIcon}, ConverterParameter=mech-activation}"
                                                   Width="14" Height="14" Margin="0,0,2,0"/>
                                            <TextBlock Text="{Binding CastTime}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Rechargement -->
                            <GridViewColumn Header="R" Width="{Binding DataContext.SkillPanel.RechargeColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Recharge time"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding Recharge, Converter={StaticResource PosFloat}}">
                                            <Image Source="{Binding Converter={StaticResource StatIcon}, ConverterParameter=mech-recharge}"
                                                   Width="14" Height="14" Margin="0,0,2,0"/>
                                            <TextBlock Text="{Binding Recharge}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="MinHeight" Value="52"/>
                            <Setter Property="ToolTipService.InitialShowDelay" Value="700"/>
                            <!-- Tooltip PARESSEUX, comme la liste multi-colonnes : le contenu est bâti
                                 par ContentTemplate à l'ouverture. Un SkillTooltipControl posé
                                 DIRECTEMENT ici serait une instance UNIQUE partagée par toutes les
                                 lignes, réutilisée de survol en survol — et le repeint de la fenêtre
                                 flottante gardait alors un chiffre de la ligne précédente (« 10 »
                                 affiché « 1 » après une compétence à 5 d'énergie). -->
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <ToolTip Content="{Binding}"
                                             ContentTemplate="{StaticResource CatalogSkillTooltipTemplate}"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsElite}" Value="True">
                                    <Setter Property="BorderBrush" Value="#FFD700"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource S.Ctx.SkillArticle}" Click="OpenSkillArticle_Click"/>
                            <MenuItem Header="{DynamicResource S.Ctx.SkillTalk}" Click="OpenSkillDiscussion_Click"/>
                            <MenuItem Header="{DynamicResource S.Ctx.SkillParse}" Click="ParseSkillInTemplates_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </Grid>
        </Grid>  <!-- /build editor Grid -->
    </Grid>  <!-- /outer content wrapper -->
    </DockPanel>
</Window>
