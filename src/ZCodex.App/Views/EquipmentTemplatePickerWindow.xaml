<Window x:Class="ZCodex.App.Views.EquipmentTemplatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Win.LoadEquipTitle}" Width="440" Height="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="2">
            <ListBox x:Name="TemplateList" BorderThickness="0" FontSize="12"
                     Background="{DynamicResource ContentBackgroundBrush}"
                     MouseDoubleClick="TemplateList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4,3">
                            <TextBlock Text="{Binding Profession}" DockPanel.Dock="Right"
                                       Foreground="{DynamicResource TextFaintBrush}" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding Name}"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Button Content="{DynamicResource S.Common.Browse}" HorizontalAlignment="Left" Width="96" Padding="4,4"
                    Click="Browse_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkBtn" Content="OK" Width="80" Padding="8,4" Margin="0,0,8,0"
                        IsDefault="True" Click="Ok_Click"/>
                <Button Content="{DynamicResource S.Common.Cancel}" Width="80" Padding="8,4" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
