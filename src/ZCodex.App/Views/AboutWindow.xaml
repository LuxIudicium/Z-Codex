<Window x:Class="ZCodex.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Win.AboutTitle}"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- Petite boîte « À propos » : identité de l'application, version (renseignée en code
         depuis l'assembly) et crédits. -->
    <StackPanel Margin="24,20">
        <!-- Le codex relié à gauche de l'identité : c'est ici qu'il paie, affiché en grand.
             L'icône système, elle, est le blason recadré — trop de détail pour 32 px. -->
        <DockPanel>
            <Image DockPanel.Dock="Left" Source="/Assets/Z-Codex-Book.png"
                   Width="96" VerticalAlignment="Top" Margin="0,3,16,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="Z-Codex" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource TextHeadingBrush}"/>
                <!-- VersionText est rempli dans le constructeur (AboutWindow.xaml.cs). -->
                <TextBlock x:Name="VersionText" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                <TextBlock Text="{DynamicResource S.About.Sub}"
                           FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource S.About.Successor}"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Discord de l'app : c'est le canal de retour (bugs, idées de fonctionnalités), donc il
             passe AVANT les crédits et la mention légale — l'URL est écrite en clair pour être
             recopiable même quand le clic vers le navigateur échoue. -->
        <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                    <Run Text="{DynamicResource S.About.Community}"/>
                    <Hyperlink NavigateUri="https://discord.gg/RAKq2BQf6" RequestNavigate="Hyperlink_RequestNavigate">
                        discord.gg/RAKq2BQf6
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text="{DynamicResource S.About.Thanks}"
                           FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                    <Run Text="{DynamicResource S.About.DataCredit}"/>
                    <Hyperlink NavigateUri="https://wiki.guildwars.com" RequestNavigate="Hyperlink_RequestNavigate">
                        Guild Wars Wiki
                    </Hyperlink>
                </TextBlock>
                <!-- Attribution PvXwiki : ses builds sont sous CC BY-NC-SA, qui EXIGE de créditer.
                     Le code de licence n'est pas traduit, c'est un identifiant. -->
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0">
                    <Run Text="{DynamicResource S.About.BuildCredit}"/>
                    <Hyperlink NavigateUri="https://gwpvx.fandom.com" RequestNavigate="Hyperlink_RequestNavigate">
                        PvXwiki
                    </Hyperlink>
                    <Run Text="— CC BY-NC-SA 3.0"/>
                </TextBlock>
                <!-- GWRank et gvg.report : deux services tiers dont Z-Codex lit les données. Ici,
                     dans le bloc des crédits, plutôt que dans la ligne de remerciements au-dessus
                     qui ne nomme que des personnes — et ici les liens sont cliquables. -->
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0">
                    <Run Text="{DynamicResource S.About.ServiceCredit}"/>
                    <Hyperlink NavigateUri="https://gwrank.com" RequestNavigate="Hyperlink_RequestNavigate">
                        GWRank
                    </Hyperlink>
                    <Run Text="·"/>
                    <Hyperlink NavigateUri="https://gvg.report" RequestNavigate="Hyperlink_RequestNavigate">
                        gvg.report
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text="{DynamicResource S.About.Disclaimer}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Button Content="{DynamicResource S.Common.Close}" Width="90" Padding="8,4" Margin="0,18,0,0" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
</Window>
