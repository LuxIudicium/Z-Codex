<UserControl x:Class="ZCodex.App.Views.ArmorCalcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:ZCodex.App.Controls"
             mc:Ignorable="d"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <!-- Tooltip PARESSEUX du catalogue d'attaques : DataContext = le Skill. Contexte catalogue
             (pas de FooterOverride) → l'infobulle montre la plage « 0…12…15 ». Bâti au 1er survol. -->
        <DataTemplate x:Key="ArmorCatalogSkillTooltipTemplate">
            <ctrl:SkillTooltipControl Skill="{Binding}"/>
        </DataTemplate>

        <!-- Listes Skill Types/Mechanics : cet écran filtre par listes déroulantes (pas d'onglets).
             Toutes les entrées sont sélectionnables — les familles sont devenues des mécaniques. -->
        <DataTemplate x:Key="CategoryComboItemTemplate">
            <TextBlock Text="{Binding DisplayLabel}" Margin="{Binding Margin}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <!-- Entrée qui ne rendrait rien avec les filtres actifs : grisée. -->
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <!-- Barre profils (haut) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ContentBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource S.Common.Profile}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                <ComboBox Width="180" FontSize="12" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ProfileNames}"
                          SelectedItem="{Binding SelectedProfileName}"/>
                <TextBox x:Name="ProfileNameBox" Width="160" Margin="10,0,4,0" FontSize="12"
                         VerticalContentAlignment="Center" ToolTip="{DynamicResource S.Armor.SaveProfileTip}"/>
                <Button Content="{DynamicResource S.Common.Save}" Padding="10,3" Margin="2,0" Click="SaveProfile_Click"/>
                <Button Content="{DynamicResource S.Common.Delete}" Padding="10,3" Margin="2,0" Click="DeleteProfile_Click"/>
                <TextBlock x:Name="ProfileStatus" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>   <!-- zones 1 + 2 -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>      <!-- zone 3 -->
            </Grid.ColumnDefinitions>

            <!-- ══════════ Colonne gauche : zones 1 et 2 (scrollable) ══════════ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel>
                    <!-- ZONE 1 — Perso / équipement -->
                    <TextBlock Text="{DynamicResource S.Armor.CharAndEquip}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource S.Armor.Profession}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" FontSize="12" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding Professions}"
                                  SelectedItem="{Binding Profession}"/>
                    </Grid>
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource S.Armor.BaseAL}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" FontSize="12" VerticalContentAlignment="Center"
                                 Text="{Binding BaseArmor, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="2" Text="{Binding InherentDescription}" VerticalAlignment="Center"
                                   FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Insignes par pièce -->
                    <TextBlock Text="{DynamicResource S.Armor.InsigniaPerPiece}" FontSize="12" Margin="0,8,0,2"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding Pieces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Column="1" FontSize="11" VerticalContentAlignment="Center"
                                              ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding Selected}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           ToolTip="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Bouclier -->
                    <TextBlock Text="{DynamicResource S.Armor.Shield}" FontSize="12" Margin="0,8,0,2"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <WrapPanel>
                        <CheckBox Content="{DynamicResource S.Armor.Equipped}" IsChecked="{Binding ShieldEquipped}" VerticalAlignment="Center"
                                  FontSize="12" Margin="0,0,12,0"/>
                        <TextBlock Text="{DynamicResource S.Armor.ALBase}" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
                        <TextBox Width="44" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,12,0"
                                 Text="{Binding ShieldBaseArmor, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="{DynamicResource S.Armor.ReqMet}" IsChecked="{Binding ShieldRequirementMet}"
                                  VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"/>
                        <CheckBox Content="{DynamicResource S.Armor.ShieldStrength}" IsChecked="{Binding ShieldIsStrength}"
                                  VerticalAlignment="Center" FontSize="12"
                                  ToolTip="{DynamicResource S.Armor.ShieldStrengthTip}"/>
                    </WrapPanel>

                    <!-- Mods d'équipement réels (runes, mods d'armes, inscriptions) -->
                    <TextBlock Text="{DynamicResource S.Armor.EquipMods}" FontSize="12"
                               Margin="0,10,0,2" Foreground="{DynamicResource TextSecondaryBrush}"
                               ToolTip="{DynamicResource S.Armor.EquipModsTip}"/>
                    <DockPanel Margin="0,0,0,2">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource S.Common.Add}" Padding="8,2" FontSize="11"
                                Click="AddMod_Click" Margin="4,0,0,0"/>
                        <ComboBox FontSize="11" VerticalContentAlignment="Center" MaxDropDownHeight="320"
                                  ItemsSource="{Binding AvailableMods}" SelectedItem="{Binding SelectedModOption}"
                                  ToolTip="{DynamicResource S.Armor.AddModTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding AddedMods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Content="✕" Width="20" FontSize="10" Padding="0"
                                            Click="RemoveMod_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ModLimitMessage}" FontSize="10" FontStyle="Italic"
                               TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding ModLimitMessage, Converter={StaticResource NullToVis}}"/>

                    <!-- État du perso : active les clauses conditionnelles des insignes (seuils,
                         comptes, situations) et les inscriptions de réduction plate conditionnelles -->
                    <TextBlock Text="{DynamicResource S.Armor.CharState}" FontSize="12" Margin="0,10,0,2"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <!-- Grille 3 colonnes au lieu d'un WrapPanel : les cases s'alignent
                         verticalement. Colonnes Auto (et non uniformes) car les libellés FR
                         sont bien plus longs (« Sort d'altération d'arme » ≈ 132 px avec la
                         case) que les 129 px qu'offriraient 3 colonnes égales sur 420 px. -->
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,2,12,2"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" Content="{DynamicResource S.Armor.Enchanted}"
                                  IsChecked="{Binding IsEnchanted}" ToolTip="{DynamicResource S.Armor.EnchantedTip}"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="{DynamicResource S.Armor.Hexed}"
                                  IsChecked="{Binding IsHexed}" ToolTip="{DynamicResource S.Armor.HexedTip}"/>
                        <CheckBox Grid.Row="0" Grid.Column="2" Content="{DynamicResource S.Armor.InStance}"
                                  IsChecked="{Binding IsInStance}" ToolTip="{DynamicResource S.Armor.InStanceTip}"/>

                        <CheckBox Grid.Row="1" Grid.Column="0" Content="{DynamicResource S.Armor.Attacking}"
                                  IsChecked="{Binding IsAttacking}" ToolTip="Brawler's, Nightstalker's"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="{DynamicResource S.Armor.HoldingItem}"
                                  IsChecked="{Binding IsHoldingItem}" ToolTip="Herald's"/>
                        <CheckBox Grid.Row="1" Grid.Column="2" Content="{DynamicResource S.Armor.UsingPrep}"
                                  IsChecked="{Binding IsUsingPreparation}" ToolTip="Scout's"/>

                        <CheckBox Grid.Row="2" Grid.Column="0" Content="{DynamicResource S.Armor.PetAlive}"
                                  IsChecked="{Binding IsPetAlive}" ToolTip="Beastmaster's"/>
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="{DynamicResource S.Armor.HasCondition}"
                                  IsChecked="{Binding HasCondition}" ToolTip="Disciple's"/>
                        <CheckBox Grid.Row="2" Grid.Column="2" Content="{DynamicResource S.Armor.Activating}"
                                  IsChecked="{Binding IsActivatingSkill}" ToolTip="Virtuoso's, Mystic's"/>

                        <CheckBox Grid.Row="3" Grid.Column="0" Content="{DynamicResource S.Armor.WeaponSpell}"
                                  IsChecked="{Binding HasWeaponSpell}" ToolTip="Ghost Forge"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" Content="{DynamicResource S.Armor.ShoutChant}"
                                  IsChecked="{Binding HasShoutChant}" ToolTip="Centurion's"/>
                    </Grid>

                    <!-- Compteurs : même principe, 3 paires libellé/champ par ligne. Les colonnes
                         de libellés sont Auto → les champs de saisie s'alignent verticalement. -->
                    <Grid Margin="0,4,0,0">
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,3,0"/>
                            </Style>
                            <Style TargetType="TextBox">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Width" Value="34"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,2,12,2"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource S.Armor.HealthPct}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HealthPercent, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource S.Armor.UndertakerTip}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource S.Armor.Enchant}"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EnchantmentCount, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource S.Armor.WindwalkerTip}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{DynamicResource S.Armor.Recharge}"/>
                        <TextBox Grid.Row="0" Grid.Column="5" HorizontalAlignment="Left"
                                 Text="{Binding RechargingSkillCount, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource S.Armor.RechargeTip}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource S.Armor.Minions}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinionCount, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource S.Armor.MinionsTip}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource S.Armor.Spirits}"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SpiritCount, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource S.Armor.SpiritsTip}"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{DynamicResource S.Armor.Signets}"/>
                        <TextBox Grid.Row="1" Grid.Column="5" HorizontalAlignment="Left"
                                 Text="{Binding SignetCount, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource S.Armor.SignetsTip}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource S.Armor.IllusionSkills}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding IllusionSkillCount, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource S.Armor.IllusionSkillsTip}"/>
                    </Grid>

                    <!-- Ajout manuel (cas non couverts par le catalogue : mods inhérents de bouclier…) -->
                    <Expander Header="{DynamicResource S.Armor.ManualAdd}" FontSize="11" Margin="0,6,0,0"
                              Foreground="{DynamicResource TextMutedBrush}">
                        <StackPanel>
                            <Button Content="{DynamicResource S.Armor.AddManualContrib}" Padding="8,2" FontSize="11"
                                    HorizontalAlignment="Left" Margin="0,2,0,2" Click="AddCustom_Click"/>
                            <ItemsControl ItemsSource="{Binding Customs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" FontSize="11"
                                                     VerticalContentAlignment="Center" Margin="0,0,2,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11" VerticalContentAlignment="Center" Margin="0,0,2,0"/>
                                            <ComboBox Grid.Column="2" FontSize="11" VerticalContentAlignment="Center"
                                                      ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,0,2,0"/>
                                            <ComboBox Grid.Column="3" FontSize="11" VerticalContentAlignment="Center"
                                                      ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" Margin="0,0,2,0"/>
                                            <Button Grid.Column="4" Content="✕" Width="20" FontSize="10" Padding="0"
                                                    Click="RemoveCustom_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- Import code P -->
                    <DockPanel Margin="0,10,0,2">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource S.Common.Import}" Padding="8,2" FontSize="11"
                                Click="ImportPCode_Click"/>
                        <TextBox x:Name="PCodeBox" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,6,0"
                                 ToolTip="{DynamicResource S.Armor.ImportEquipCodeTip}"/>
                    </DockPanel>

                    <!-- ZONE 2 — Sources externes -->
                    <TextBlock Text="{DynamicResource S.Armor.ExternalSources}" FontWeight="SemiBold"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,4"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource S.Armor.ArmorPenetration}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" FontSize="12" VerticalContentAlignment="Center"
                                 Text="{Binding ArmorPenetrationPercent, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding EffectsView}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                   Margin="0,8,0,2" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Label}" FontSize="12"/>
                                            <TextBlock Text="{Binding ConditionFr}" FontSize="10" FontStyle="Italic"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Visibility="{Binding ConditionFr, Converter={StaticResource NullToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" FontSize="11" VerticalContentAlignment="Center"
                                             Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsProgressive, Converter={StaticResource BoolToVisibilityConverter}}"
                                             ToolTip="{DynamicResource S.Armor.CasterAttrRankTip}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ResolvedValueText}" FontSize="12"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="{DynamicResource BorderLightBrush}"/>

            <!-- ══════════ Colonne droite : zone 3 (résultats + détail) + zone 4 (attaques) ══════════
                 Grid en lignes redimensionnables (17/07) : ligne 1 = grille + détail CÔTE À CÔTE ;
                 splitter horizontal ; ligne 3 (remplit) = attaques de référence toujours visibles
                 (plus d'expander, plus de ligne de contexte ni de légende — demande Philippe pour
                 laisser la place au catalogue) ; récap durées tout en bas. Splitters : entre le haut
                 et les attaques, et à l'intérieur entre le catalogue et le tableau d'attaques. -->
            <Grid Grid.Column="2" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>                 <!-- titre -->
                    <RowDefinition Height="2*" MinHeight="110"/>   <!-- grille + détail (redimensionnable) -->
                    <RowDefinition Height="Auto"/>                 <!-- splitter horizontal -->
                    <RowDefinition Height="3*" MinHeight="170"/>   <!-- attaques de référence (remplit) -->
                    <RowDefinition Height="Auto"/>                 <!-- récap durées -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource S.Armor.EffectiveALTitle}"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                <!-- Ligne 1 : grille (gauche) + détail dépliable (droite) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Grille de résultats -->
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- En-tête de colonnes (coin de 88px pour aligner avec la colonne des libellés) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Border Width="88" Height="26"/>
                                <ItemsControl ItemsSource="{Binding ColumnList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="62" Height="26" BorderBrush="{DynamicResource BorderLightBrush}"
                                                    BorderThickness="0,0,1,1">
                                                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <!-- Rows -->
                            <ItemsControl ItemsSource="{Binding ResultRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="88" MinHeight="34" BorderBrush="{DynamicResource BorderLightBrush}"
                                                    BorderThickness="0,0,1,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpectancy}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Label}" FontSize="11" Margin="4,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="{Binding IsExpectancy, Converter={StaticResource BoolToBold}}"/>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="62" MinHeight="34" BorderThickness="0,0,1,1"
                                                                BorderBrush="{DynamicResource BorderLightBrush}"
                                                                MouseLeftButtonUp="Cell_Click" Cursor="Hand">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding AlText}" FontSize="13" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding PercentText}" FontSize="9"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Détail dépliable (droite) -->
                    <Border Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="8"
                            Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding BreakdownHeader}" FontWeight="SemiBold" FontSize="12"
                                           Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding BreakdownLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Text}" FontSize="11"
                                                           FontWeight="{Binding IsHeader, Converter={StaticResource BoolToBold}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="11"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Splitter horizontal : redimensionne le haut (grille + détail) vs les attaques -->
                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource BorderLightBrush}" Margin="0,4"/>

                <!-- Ligne 3 (remplit) — ZONE 4 : attaques de référence (dégâts subis @AL 60 vs @AL build).
                     Plus d'expander/contexte/légende (demande Philippe) → toute la place au catalogue. -->
                <Border Grid.Row="3" Background="{DynamicResource ContentBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="8">
                        <!-- Grid interne : catalogue (ligne *) et tableau des attaques (ligne *)
                             séparés par un splitter — les deux redimensionnables. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>          <!-- filtres catalogue -->
                                <RowDefinition Height="Auto"/>          <!-- recherche + Ajouter -->
                                <RowDefinition Height="2*" MinHeight="80"/>   <!-- liste du catalogue -->
                                <RowDefinition Height="Auto"/>          <!-- splitter interne -->
                                <RowDefinition Height="1*" MinHeight="60"/>   <!-- en-tête + tableau attaques -->
                            </Grid.RowDefinitions>

                            <!-- Catalogue STANDARD (demande Philippe 17/07) : mêmes filtres que le
                                 teambuilder (profession, attribut, PvE/PvP, recherche par nom) + un
                                 filtre spécifique « Dégâts seulement ». Double-clic, Entrée ou
                                 « + Ajouter » ajoutent la skill sélectionnée à la table. -->
                            <WrapPanel Grid.Row="0" Margin="0,0,0,2">
                                <ComboBox Width="118" FontSize="11" Margin="0,1,6,1" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding AttackCatalog.Professions}"
                                          SelectedItem="{Binding AttackCatalog.SelectedProfessionOption}"
                                          ToolTip="{DynamicResource S.Armor.ProfFilterTip}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Width="150" FontSize="11" Margin="0,1,6,1" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding AttackCatalog.ProfessionAttributes}"
                                          SelectedItem="{Binding AttackCatalog.SelectedProfessionAttribute}"
                                          ToolTip="{DynamicResource S.Armor.AttrFilterTip}">
                                    <!-- Items = clés EN (filtrage) ; affichage FR via converter. Le template ComboBox
                                         partagé honore SelectionBoxItemTemplate → zone de sélection traduite aussi. -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource AttrDisplay}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Width="96" FontSize="11" Margin="0,1,6,1" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding AttackCatalog.GameModes}"
                                          SelectedValuePath="Mode"
                                          SelectedValue="{Binding AttackCatalog.SelectedGameMode}"
                                          ToolTip="{DynamicResource S.Armor.GameModeTip}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <CheckBox Content="{DynamicResource S.Armor.DamageOnly}" FontSize="11" VerticalAlignment="Center"
                                          IsChecked="{Binding DamageOnlyFilter}"
                                          ToolTip="{DynamicResource S.Armor.DamageOnlyTip}"/>
                                <!-- Skill Types/Mechanics : cet écran n'a pas d'onglets, ce sont donc
                                     deux listes de plus, dans la même barre que les autres filtres.
                                     Le booléen vit sur MainViewModel → RelativeSource jusqu'à la fenêtre. -->
                                <CheckBox FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                                          IsChecked="{Binding DataContext.ShowCategoryColumns, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Content="{DynamicResource S.Cat.ToggleLabel}"
                                          ToolTip="{DynamicResource S.Cat.ToggleTip}"/>
                                <ComboBox Width="150" FontSize="11" Margin="8,1,6,1" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding AttackCatalog.TypeCategories}"
                                          SelectedItem="{Binding AttackCatalog.SelectedTypeItem}"
                                          ItemTemplate="{StaticResource CategoryComboItemTemplate}"
                                          Visibility="{Binding DataContext.ShowCategoryColumns, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <ComboBox Width="170" FontSize="11" Margin="0,1,6,1" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding AttackCatalog.MechanicCategories}"
                                          SelectedItem="{Binding AttackCatalog.SelectedMechanicItem}"
                                          ItemTemplate="{StaticResource CategoryComboItemTemplate}"
                                          Visibility="{Binding DataContext.ShowCategoryColumns, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </WrapPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,0,2">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource S.Common.Add}" Padding="8,2" FontSize="11"
                                            Click="AddAttack_Click" Margin="4,0,0,0"/>
                                    <TextBox x:Name="AttackSearchBox" FontSize="11" VerticalContentAlignment="Center"
                                             KeyDown="AttackSearchBox_KeyDown"
                                             Text="{Binding AttackCatalog.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{DynamicResource S.Armor.SearchCatalogTip}"/>
                                </DockPanel>
                                <!-- Ligne de retour : catégories reconnues + ce que les filtres cachent. -->
                                <TextBlock Style="{StaticResource SearchNoticeStyle}" Tag="{Binding AttackCatalog}"
                                           Text="{Binding AttackCatalog.SearchNotice}"
                                           Visibility="{Binding AttackCatalog.HasSearchNotice, Converter={StaticResource BoolToVisibilityConverter}}"
                                           MouseLeftButtonUp="SearchNotice_Click"/>
                            </StackPanel>
                            <ListBox Grid.Row="2" MinHeight="60" FontSize="11" Margin="0,0,0,4"
                                     ItemsSource="{Binding AttackCatalog.FilteredSkills}"
                                     SelectedItem="{Binding AttackCatalog.SelectedSkill}"
                                     MouseDoubleClick="AttackResult_DoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="ToolTipService.InitialShowDelay" Value="600"/>
                                        <!-- Infobulle « 0…12…15 » paresseuse (bâtie au survol). -->
                                        <Setter Property="ToolTip">
                                            <Setter.Value>
                                                <ToolTip Content="{Binding}"
                                                         ContentTemplate="{StaticResource ArmorCatalogSkillTooltipTemplate}"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="16" Height="16" Margin="0,0,4,0"
                                                   Source="{Binding IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=24}"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Splitter interne : catalogue (dessus) vs tableau des attaques (dessous).
                                 En-tête + tableau réunis dans le MÊME DockPanel (ligne *) pour que le
                                 splitter redimensionne bien catalogue ↔ tableau (fix 17/07 : une ligne
                                 Auto intercalée faisait pousser les attaques dans le mauvais sens). -->
                            <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                          Background="{DynamicResource BorderLightBrush}" Margin="0,2"/>

                            <DockPanel Grid.Row="4">
                                <!-- En-tête (fixe en haut) -->
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Armor.ColAttack}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource S.Armor.ColConditions}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource S.Armor.ColRank}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{DynamicResource S.Armor.ColAtAL60}" FontSize="10" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{DynamicResource S.Armor.ColAtALBuild}" FontSize="10" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="5" Text="Δ" FontSize="10" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}"/>
                                </Grid>

                                <!-- Lignes des attaques ajoutées (remplit + défilement) -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ReferenceAttacks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="66"/>
                                                    <ColumnDefinition Width="66"/>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Nom + note. Tooltip « calculée » (description résolue au rang
                                                     + table de dégâts d'arme) via le SkillTooltipControl. -->
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.ToolTip>
                                                        <ctrl:SkillTooltipControl Skill="{Binding Skill}"
                                                                                  DescriptionOverride="{Binding ResolvedDescription}"
                                                                                  AttributeRank="{Binding Rank}"
                                                                                  WeaponMasteryRank="{Binding WeaponMasteryRank}"/>
                                                    </StackPanel.ToolTip>
                                                    <Image Width="20" Height="20" Margin="0,0,5,0"
                                                           Source="{Binding IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=24}"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                        <TextBlock Text="{Binding Notes}" FontSize="9" FontStyle="Italic"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Altérations infligées : pilules « icône + durée effective (base) »
                                                     (max 3 : Shockwave/Virulence). Colonne fixe → alignées verticalement. -->
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Conditions}"
                                                              VerticalAlignment="Center" Margin="2,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,1,3,1" Padding="3,1" CornerRadius="8"
                                                                    Background="#3343A047" BorderBrush="#4CAF50" BorderThickness="1"
                                                                    ToolTip="{Binding ToolTipText}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Image Source="{Binding Icon}" Width="14" Height="14"
                                                                           Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding DurationText}" FontSize="10"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    <TextBlock Text="{Binding BaseText}" FontSize="9"
                                                                               Margin="2,0,0,0" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBox Grid.Column="2" FontSize="11" VerticalContentAlignment="Center"
                                                         Margin="0,0,4,0" Height="20"
                                                         Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="{DynamicResource S.Armor.AttackerAttrRankTip}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Text60}" FontSize="12"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="{Binding TextCalc}" FontSize="12"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="5" Text="{Binding DeltaText}" FontSize="11"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMitigated}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SkillVariableBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="6" Content="✕" Width="20" FontSize="10" Padding="0"
                                                        Margin="4,0,0,0" Click="RemoveAttack_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>

                <!-- Ligne 4 : récap des réductions de durée d'altération (mods/insignes cochés) -->
                <Border Grid.Row="4" Background="{DynamicResource ContentBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="8"
                        Margin="0,8,0,0"
                        Visibility="{Binding DurationSummaries.Count, Converter={StaticResource PosInt}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Armor.DurationReductions}" FontWeight="SemiBold"
                                   FontSize="12" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding DurationSummaries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding HeaderText}" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SourcesText}" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
