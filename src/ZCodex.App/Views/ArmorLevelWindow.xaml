<Window x:Class="ZCodex.App.Views.ArmorLevelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Win.ArmorDmgTitle}" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="{DynamicResource S.Armor.CustomALs}"
                   Margin="0,0,0,8" FontSize="13" TextWrapping="Wrap"/>
        <!-- Champs d'AL custom ajoutés en code (un TextBox par valeur, bouton + jusqu'à 8). -->
        <StackPanel x:Name="CustomLevelsPanel"/>
        <Button x:Name="AddLevelButton" Content="+" Width="28" Padding="0,2" Margin="0,0,0,12"
                HorizontalAlignment="Left" Click="AddLevel_Click"
                ToolTip="{DynamicResource S.Armor.AddCol}"/>
        <TextBlock Text="{DynamicResource S.Armor.CharLevel}"
                   Margin="0,0,0,8" FontSize="13"/>
        <TextBox x:Name="CharacterLevelBox" FontSize="13" Padding="6,4" Margin="0,0,0,12"
                 KeyDown="LevelBox_KeyDown"/>
        <TextBlock Text="{DynamicResource S.Armor.TargetLevel}"
                   Margin="0,0,0,8" FontSize="13"/>
        <TextBox x:Name="TargetLevelBox" FontSize="13" Padding="6,4" Margin="0,0,0,12"
                 KeyDown="LevelBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Padding="8,4" Margin="0,0,8,0"
                    IsDefault="True" Click="Ok_Click"/>
            <Button Content="{DynamicResource S.Common.Cancel}" Width="80" Padding="8,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
