<Window x:Class="ZCodex.App.Views.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Msg.RenameTitle}" Width="360" Height="130"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="{DynamicResource S.Win.NewName}" Margin="0,0,0,8" FontSize="13"/>
        <TextBox x:Name="NameBox" FontSize="13" Padding="6,4" Margin="0,0,0,12"
                 KeyDown="NameBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Padding="8,4" Margin="0,0,8,0"
                    IsDefault="True" Click="Ok_Click"/>
            <Button Content="{DynamicResource S.Common.Cancel}" Width="80" Padding="8,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
