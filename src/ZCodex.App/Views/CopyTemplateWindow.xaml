<Window x:Class="ZCodex.App.Views.CopyTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Win.CopyTplTitle}" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="16">
        <!-- Code GW1 brut -->
        <TextBlock Text="{DynamicResource S.Win.GwCode}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="{DynamicResource S.Common.Copy}" Width="80" Padding="8,4"
                    Margin="8,0,0,0" Click="CopyCode_Click"/>
            <TextBox x:Name="CodeBox" FontSize="12" Padding="6,4" IsReadOnly="True"
                     VerticalContentAlignment="Center" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>

        <!-- Code format chat -->
        <TextBlock Text="{DynamicResource S.Win.ChatFormat}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="{DynamicResource S.Common.Copy}" Width="80" Padding="8,4"
                    Margin="8,0,0,0" Click="CopyChat_Click"/>
            <TextBox x:Name="ChatBox" FontSize="12" Padding="6,4" IsReadOnly="True"
                     VerticalContentAlignment="Center" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>

        <Button Content="{DynamicResource S.Common.Close}" Width="80" Padding="8,4" HorizontalAlignment="Right"
                IsCancel="True"/>
    </StackPanel>
</Window>
