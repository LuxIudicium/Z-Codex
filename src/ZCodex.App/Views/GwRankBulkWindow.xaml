<Window x:Class="ZCodex.App.Views.GwRankBulkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.GwRank.BulkTitle}"
        Width="580" SizeToContent="Height" MinHeight="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="Window_Closing">

    <!-- Deux temps volontairement séparés : ANALYSER, puis ENVOYER. Sur des dizaines de fichiers,
         découvrir après coup ce qu'on a déposé serait intenable — l'utilisateur voit le lot avant
         qu'une seule requête ne parte.

         Aucun ProgressBar ni ListBoxItem ici : ces deux-là n'ont pas de style implicite dans
         Themes/Controls.xaml et sortiraient en noir sur noir en thème sombre. -->
    <StackPanel Margin="22,18">

        <TextBlock Text="{DynamicResource S.GwRank.BulkIntro}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- Choix des dossiers. La bibliothèque de référence contient des milliers de gabarits de
             personnage venus de packs téléchargés : c'est à l'utilisateur de désigner ce qui est
             à lui, jamais à Z-Codex de le deviner. -->
        <TextBlock Text="{DynamicResource S.GwRank.BulkFolders}" FontWeight="SemiBold"
                   Margin="0,16,0,0"/>
        <Border Margin="0,6,0,0" MaxHeight="330"
                Background="{DynamicResource InsetBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FolderList" Margin="10,8"/>
            </ScrollViewer>
        </Border>

        <!-- Bilan de l'analyse : ce qui partirait, et ce qui ne partira pas. -->
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,16,0,0"
                   Visibility="Collapsed"/>

        <Border x:Name="AttentionPanel" Visibility="Collapsed" Margin="0,12,0,0" MaxHeight="180"
                Background="{DynamicResource WarningBackgroundBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,9">
                    <TextBlock x:Name="AttentionTitle" TextWrapping="Wrap" FontWeight="SemiBold"
                               FontSize="12"/>
                    <ItemsControl x:Name="AttentionList" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"
                                           Margin="0,0,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Avancement en texte : un compteur dit la même chose qu'une barre, sans dépendre d'un
             contrôle non stylé. -->
        <TextBlock x:Name="ProgressText" Visibility="Collapsed" Margin="0,14,0,0" FontSize="12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CloseButton" Content="{DynamicResource S.Common.Cancel}" Padding="14,4"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="AnalyzeButton" Content="{DynamicResource S.GwRank.BulkAnalyze}"
                    Padding="14,4" Margin="8,0,0,0" IsDefault="True" Click="Analyze_Click"/>
            <Button x:Name="SendButton" Content="{DynamicResource S.GwRank.BulkSendIdle}"
                    Padding="14,4" Margin="8,0,0,0" Visibility="Collapsed" Click="Send_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
