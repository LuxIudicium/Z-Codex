<Window x:Class="ZCodex.App.Views.SpikeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:ZCodex.App.Controls"
        xmlns:beh="clr-namespace:ZCodex.App.Behaviors"
        xmlns:vm="clr-namespace:ZCodex.App.ViewModels"
        Title="{Binding Build.Name, StringFormat={}Spike damage calculus — {0}}"
        Width="1300" Height="760" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- CaptureRoot : racine rendue par le bouton 📷 (fond posé ici pour une image opaque).
         Rangée haute en Auto : le panneau de résultats remonte juste sous le contenu
         (maquette Philippe) et la liste prend tout le reste. -->
    <Grid x:Name="CaptureRoot" Background="{DynamicResource DialogBackgroundBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>

            <!-- ── Panneau gauche : roster (cadenas Spike) en 2 colonnes, skills cliquables ── -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Left" Content="{DynamicResource S.Spike.Teambuild}" Padding="8,3"
                            Click="SelectRoster_Click"
                            ToolTip="{DynamicResource S.Spike.TeambuildTip}"/>
                    <TextBlock Text="{DynamicResource S.Spike.ClickHint}"
                               FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                    <ItemsControl ItemsSource="{Binding Build.SpikeMembers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderLightBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,6,0,8" Margin="0,0,14,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding ProfessionDisplay}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock beh:SkillMarkup.Text="{Binding AttributeSummaryMarkup}" FontSize="10"
                                                   Foreground="{DynamicResource TextFaintBrush}"
                                                   TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        <ItemsControl ItemsSource="{Binding SkillSlots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border MouseLeftButtonDown="SkillSlot_Click" Cursor="Hand"
                                                            Margin="0,4,4,0" CornerRadius="2"
                                                            Background="{DynamicResource ControlBackgroundBrush}"
                                                            ToolTipService.IsEnabled="{Binding HasSkill}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSpikeSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#43A047"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.ToolTip>
                                                            <ctrl:SkillTooltipControl Skill="{Binding Skill}"
                                                                                      FooterOverride="{Binding Footer}"
                                                                                      DescriptionOverride="{Binding Description}"
                                                                                      AttributeRank="{Binding AttributeRank}"
                                                                                      WeaponMastery="{Binding WeaponMastery}"
                                                                                      WeaponMasteryRank="{Binding WeaponMasteryRank}"
                                                                                      StrengthRank="{Binding StrengthRank}"
                                                                                      CriticalStrikesRank="{Binding CriticalStrikesRank}"
                                                                                      ExpertiseRank="{Binding ExpertiseRank}"
                                                                                      SpawningPowerRank="{Binding SpawningPowerRank}"
                                                                                      FluxEnergyPercent="{Binding FluxEnergyPercent}"
                                                                                      FluxDamagePercent="{Binding FluxDamagePercent}"
                                                                                      FluxCastPercent="{Binding FluxCastPercent}"
                                                                                      NatureRituals="{Binding NatureRituals}"
                                                                                      RoaringWindsBonus="{Binding RoaringWindsBonus}"
                                                                                      EnchantEnchantingPct="{Binding EnchantEnchantingPct}"
                                                                                      EnchantExtenderPct="{Binding EnchantExtenderPct}"
                                                                                      EnchantTranquilityPct="{Binding EnchantTranquilityPct}"/>
                                                        </Border.ToolTip>
                                                        <Grid Width="40" Height="40">
                                                            <Image Source="{Binding Skill.IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=64}"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <!-- Indice de l'ordre de cast (Chain Combo) sur la skill sélectionnée. -->
                                                            <Border Width="16" Height="16" CornerRadius="8" Background="#43A047"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0"
                                                                    Visibility="{Binding IsSpikeSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding SpikeOrder}" Foreground="White"
                                                                           FontSize="10" FontWeight="Bold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Buffs d'arme (chantier 14) : icônes cliquables PAR PERSO
                                             (grisé = inactif, cadre vert = actif). Proposés si équipés
                                             sur un membre du roster (DWG : sur son seul porteur) ;
                                             état persisté (.pn3 v11). -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                                    Visibility="{Binding HasSpikeBuffToggles, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource S.Spike.Buffs}" FontSize="10"
                                                       Foreground="{DynamicResource TextFaintBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <ItemsControl ItemsSource="{Binding SpikeBuffToggles}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border MouseLeftButtonDown="BuffToggle_Click" Cursor="Hand"
                                                                Margin="0,0,4,0" CornerRadius="2" BorderThickness="2"
                                                                ToolTip="{Binding Tooltip}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#43A047"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Width="20" Height="20" Stretch="Uniform"
                                                                   Source="{Binding IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=64}"
                                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Opacity" Value="0.35"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Opacity" Value="1"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ── Panneau droit : la cible (maquette : champs pleine largeur, bonus en 2 colonnes) ── -->
            <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="3"
                    VerticalAlignment="Top">
                <StackPanel Margin="12,10">
                    <TextBlock Text="{DynamicResource S.Spike.Target}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource S.Common.Profile}" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  FontSize="12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="🗑" Padding="6,2" Margin="4,0,0,0"
                                Click="DeleteProfile_Click" ToolTip="{DynamicResource S.Spike.DeleteProfileTip}"/>
                        <Button DockPanel.Dock="Right" Content="💾" Padding="6,2" Margin="4,0,0,0"
                                Click="SaveProfile_Click" ToolTip="{DynamicResource S.Spike.SaveProfileTip}"/>
                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" Padding="3,2" ToolTip="{DynamicResource S.Spike.ProfileNameTip}"/>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,8,4"/>
                            </Style>
                            <Style TargetType="TextBox">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="3,2"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </Grid.Resources>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource S.Spike.TargetPrimaryProf}"
                                   ToolTip="{DynamicResource S.Spike.TargetPrimaryProfTip}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" FontSize="12" Margin="0,0,0,4"
                                  ItemsSource="{x:Static vm:SpikeViewModel.TargetProfessionOptions}"
                                  SelectedValue="{Binding TargetPrimaryProfession}"
                                  SelectedValuePath="Profession"
                                  ToolTip="{DynamicResource S.Spike.TargetPrimaryProfCombo}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource S.Spike.TargetAL}"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding BaseArmor, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource S.Spike.TargetLevel}"
                                   ToolTip="{DynamicResource S.Spike.TargetLevelTip}"/>
                        <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding TargetLevel, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource S.Spike.TargetMaxHp}"
                                   ToolTip="{DynamicResource S.Spike.TargetMaxHpTip}"/>
                        <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding MaxHealth, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource S.Spike.TargetCurHp}"
                                   ToolTip="{DynamicResource S.Spike.TargetCurHpTip}"/>
                        <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding TargetCurrentHealth, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource S.Spike.ALBonusVs}" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,4"/>
                    <!-- 2 colonnes (maquette) : élémentaires à gauche, physiques à droite. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,8,4"/>
                            </Style>
                            <Style TargetType="TextBox">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="3,2"/>
                                <Setter Property="Margin" Value="0,0,14,4"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </Grid.Resources>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource S.Dmg.Elemental}"/>
                        <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding BonusElemental, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource S.Dmg.Fire}"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding BonusFire, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource S.Dmg.Cold}"/>
                        <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding BonusCold, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource S.Dmg.Earth}"/>
                        <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding BonusEarth, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource S.Dmg.Lightning}"/>
                        <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding BonusLightning, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource S.Dmg.Physical}"/>
                        <TextBox  Grid.Row="0" Grid.Column="3" Text="{Binding BonusPhysical, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource S.Dmg.Slashing}"/>
                        <TextBox  Grid.Row="1" Grid.Column="3" Text="{Binding BonusSlashing, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource S.Dmg.Piercing}"/>
                        <TextBox  Grid.Row="2" Grid.Column="3" Text="{Binding BonusPiercing, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{DynamicResource S.Dmg.Blunt}"/>
                        <TextBox  Grid.Row="3" Grid.Column="3" Text="{Binding BonusBlunt, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                    </Grid>

                    <TextBlock FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{DynamicResource S.Spike.ALBonusHint}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Panneau bas : résultats (remonté sous le contenu, liste extensible) ── -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,1,0,0"
                Margin="0,10,0,0" Padding="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" x:Name="CaptureButton" Content="{DynamicResource S.Spike.CaptureImage}"
                            Padding="8,2" Click="Capture_Click"
                            ToolTip="{DynamicResource S.Spike.CaptureTip}"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="{DynamicResource S.Spike.DeepWound}" IsChecked="{Binding WithDeepWound}" Margin="0,0,14,0"
                                  VerticalAlignment="Center"
                                  ToolTip="{DynamicResource S.Spike.DeepWoundTip}"/>
                        <CheckBox Content="{DynamicResource S.Spike.CrackedArmor}" IsChecked="{Binding WithCrackedArmor}" Margin="0,0,14,0"
                                  VerticalAlignment="Center"
                                  ToolTip="{DynamicResource S.Spike.CrackedArmorTip}"/>
                        <CheckBox Content="{DynamicResource S.Spike.AllCrits}" IsChecked="{Binding AllCrits}"
                                  VerticalAlignment="Center"
                                  ToolTip="{DynamicResource S.Spike.AllCritsTip}"/>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Spike.NoSkillSelected}"
                                   FontStyle="Italic" FontSize="11" Foreground="{DynamicResource TextFaintBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRows}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- En-têtes de colonnes (mêmes largeurs que les lignes, centrés à l'identique). -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,4"
                              Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{DynamicResource S.Spike.ColSkill}" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource S.Spike.ColCombat}" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource S.Spike.ColDamage}" FontWeight="Bold" FontSize="11"
                                       TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource S.Spike.ColFluxBonus}" FontWeight="Bold" FontSize="11"
                                       TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"
                                       ToolTip="{Binding FluxDescription}"/>
                        </Grid>
                        <!-- Colonnes fixes (icône/détail/contrôle-extra/valeur/bonus flux) : mêmes
                             positions sur toutes les lignes, qu'il y ait un combo ou non. Bloc centré
                             (HorizontalAlignment=Center de l'ItemsControl) plutôt que plaqué au bord
                             droit de la fenêtre (demande Philippe, capture annotée). -->
                        <ItemsControl ItemsSource="{Binding Rows}" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="320"/>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,6,0"
                                               VerticalAlignment="Top"
                                               Source="{Binding IconPath, Converter={StaticResource UrlToImage}, ConverterParameter=64}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SkillName}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding CharacterName}" FontSize="11"
                                                           Foreground="{DynamicResource TextFaintBrush}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <!-- Contrôle extra (ticks ET/OU type d'arme, empilés si les deux
                                             s'appliquent) : colonne fixe, même position sur toutes les lignes. -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                                        Visibility="{Binding HasProcs, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource S.Spike.Procs}" FontSize="10"
                                                           Foreground="{DynamicResource TextFaintBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox MinWidth="52" FontSize="10" Padding="4,1"
                                                          VerticalAlignment="Center"
                                                          ItemsSource="{x:Static vm:SpikeViewModel.ProcOptions}"
                                                          SelectedItem="{Binding ProcsValue}"
                                                          ToolTip="{DynamicResource S.Spike.ProcsTip}"/>
                                            </StackPanel>
                                            <!-- Compteur de SEUIL (« X for each [ressource] (maximum Y) ») : nombre
                                                 d'unités comptées (signets, conditions, enchantements…), défaut = max. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                                        Visibility="{Binding HasThreshold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource S.Spike.Threshold}" FontSize="10"
                                                           Foreground="{DynamicResource TextFaintBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox MinWidth="52" FontSize="10" Padding="4,1"
                                                          VerticalAlignment="Center"
                                                          ItemsSource="{Binding ThresholdOptions}"
                                                          SelectedItem="{Binding ThresholdValue}"
                                                          ToolTip="{Binding ThresholdClause}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                                        Visibility="{Binding HasTicks, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource S.Spike.Ticks}" FontSize="10"
                                                           Foreground="{DynamicResource TextFaintBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox MinWidth="52" FontSize="10" Padding="4,1"
                                                          VerticalAlignment="Center"
                                                          ItemsSource="{Binding TickOptions}"
                                                          SelectedItem="{Binding Slot.SpikeTicks}"
                                                          ToolTip="{DynamicResource S.Spike.TicksTip}"/>
                                            </StackPanel>
                                            <!-- Compteur de PROJECTILES (Stone Daggers 2, Dancing Daggers 3) :
                                                 nombre de projectiles qui touchent la cible, tous comptés par défaut. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                                        Visibility="{Binding HasProjectiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource S.Spike.Projectiles}" FontSize="10"
                                                           Foreground="{DynamicResource TextFaintBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox MinWidth="52" FontSize="10" Padding="4,1"
                                                          VerticalAlignment="Center"
                                                          ItemsSource="{Binding ProjectileOptions}"
                                                          SelectedItem="{Binding ProjectilesValue}"
                                                          ToolTip="{DynamicResource S.Spike.ProjectilesTip}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsWeaponRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource S.Spike.WeaponDmgType}" FontSize="10"
                                                           Foreground="{DynamicResource TextFaintBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox MinWidth="130" FontSize="10" Padding="4,1"
                                                          VerticalAlignment="Center"
                                                          ItemsSource="{Binding WeaponTypeOptions}"
                                                          SelectedValue="{Binding Slot.SpikeWeaponDamageType}"
                                                          SelectedValuePath="Value"
                                                          ToolTip="{DynamicResource S.Spike.WeaponDmgTypeTip}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                            <!-- Mod de PRÉFIXE physique de l'arme (de fractionnement / vampirique) :
                                                 proposé tant que le type de dégâts choisi n'est pas élémentaire — les
                                                 deux occupent le même emplacement de préfixe. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                        Visibility="{Binding CanChooseMod, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource S.Spike.WeaponMod}" FontSize="10"
                                                           Foreground="{DynamicResource TextFaintBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox MinWidth="130" FontSize="10" Padding="4,1"
                                                          VerticalAlignment="Center"
                                                          ItemsSource="{Binding ModOptions}"
                                                          SelectedValue="{Binding Slot.SpikeWeaponModKey}"
                                                          SelectedValuePath="Key"
                                                          ToolTip="{DynamicResource S.Spike.WeaponModTip}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                            <!-- Proc du fractionnement (20 % du temps) : relève la pénétration de toute
                                                 la ligne. Arc corne : +10 % permanents sur toutes ses attaques. -->
                                            <CheckBox Margin="0,2,0,0" FontSize="10" VerticalAlignment="Center"
                                                      Content="{DynamicResource S.Spike.SunderingProc}"
                                                      IsChecked="{Binding Slot.SpikeSunderingProc}"
                                                      Visibility="{Binding HasSunderingProc, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      ToolTip="{DynamicResource S.Spike.SunderingProcTip}"/>
                                            <CheckBox Margin="0,2,0,0" FontSize="10" VerticalAlignment="Center"
                                                      Content="{DynamicResource S.Spike.Hornbow}"
                                                      IsChecked="{Binding Slot.SpikeHornbow}"
                                                      Visibility="{Binding IsBowRow, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      ToolTip="{DynamicResource S.Spike.HornbowTip}"/>
                                            <!-- Attaque d'arme libre : choix d'arme toujours proposé (défaut = arme de
                                                 l'attribut si c'est une maîtrise, sinon déduite). Options PAR LIGNE :
                                                 restreintes aux armes de la catégorie du type d'attaque. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                        Visibility="{Binding CanChooseWeapon, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource S.Spike.Weapon}" FontSize="10"
                                                           Foreground="{DynamicResource TextFaintBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox MinWidth="110" FontSize="10" Padding="4,1"
                                                          VerticalAlignment="Center"
                                                          ItemsSource="{Binding WeaponOptions}"
                                                          SelectedValue="{Binding Slot.SpikeWeaponKind}"
                                                          SelectedValuePath="Mastery"
                                                          ToolTip="{DynamicResource S.Spike.WeaponTip}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                            <!-- Part conditionnelle (« X more damage if [état] ») : cochée = comptée (défaut). -->
                                            <CheckBox Margin="0,2,0,0" FontSize="10" VerticalAlignment="Center"
                                                      Content="{DynamicResource S.Spike.ConditionMet}"
                                                      IsChecked="{Binding Slot.SpikeConditional}"
                                                      Visibility="{Binding HasConditional, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      ToolTip="{Binding ConditionText}"/>
                                            <!-- PV du lanceur (Grenth's Balance) : courants / max. Commit sur
                                                 LostFocus (défaut TextBox) : chaque frappe reconstruit sinon les
                                                 lignes (Recalculate → Rows.Clear) et vole le focus au champ. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                        Visibility="{Binding HasCasterHp, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource S.Spike.CasterHp}" FontSize="10"
                                                           Foreground="{DynamicResource TextFaintBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox Width="44" FontSize="10" Padding="3,1" TextAlignment="Right"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding CasterCurrentHp, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="{DynamicResource S.Spike.CasterHpTip}"/>
                                                <TextBlock Text="/" FontSize="10" VerticalAlignment="Center" Margin="3,0"
                                                           Foreground="{DynamicResource TextFaintBrush}"/>
                                                <TextBox Width="44" FontSize="10" Padding="3,1" TextAlignment="Right"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding CasterMaxHp, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="{DynamicResource S.Spike.CasterMaxHpTip}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding RangeText}" FontWeight="Bold"
                                                   FontSize="13" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="{Binding FluxBonusText}" FontWeight="SemiBold"
                                                   FontSize="12" VerticalAlignment="Center" TextAlignment="Right"
                                                   Foreground="#C77DBB"
                                                   ToolTip="{Binding DataContext.FluxDescription, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Text="{Binding TotalText}" FontWeight="Bold" FontSize="14"
                           HorizontalAlignment="Right" Margin="0,6,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
