<Window x:Class="ZCodex.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="820" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- Aide de référence : catalogue exhaustif des menus, actions, raccourcis clavier et
         gestes souris. Le CONTENU vit dans HelpContent.cs (une ligne = ses deux langues) ;
         ce fichier n'en est que le rendu. Titre, intro, version et sections sont posés par
         HelpWindow.RefreshLanguage — d'où l'absence de Title ici. -->
    <Window.Resources>
        <!-- Titre de section -->
        <Style x:Key="HelpH" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
            <Setter Property="Margin" Value="0,18,0,4"/>
        </Style>
        <!-- Ligne d'introduction / note de section (gris) -->
        <Style x:Key="HelpNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Colonne de gauche d'une ligne : geste / raccourci / chemin de menu (accent, largeur fixe) -->
        <Style x:Key="HelpKey" TargetType="TextBlock">
            <Setter Property="Width" Value="248"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <!-- Colonne de droite : description de l'action -->
        <Style x:Key="HelpDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Ligne (geste | description). LastChildFill : la description occupe le reste. -->
        <Style x:Key="HelpRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Pied : bouton Fermer (Échap/Entrée) -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <Button Content="{DynamicResource S.Common.Close}" Width="90" Padding="8,4" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,12,20,16">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextHeadingBrush}"/>
                <TextBlock x:Name="IntroText" Style="{StaticResource HelpNote}" Margin="0,2,0,0"/>
                <!-- Version du contenu de l'aide (HelpContent.VersionFr/En) -->
                <TextBlock x:Name="VersionText" FontSize="11" Margin="0,0,0,2"
                           Foreground="{DynamicResource TextMutedBrush}"/>

                <ItemsControl x:Name="SectionsHost">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpH}" Text="{Binding Title}"/>
                                <TextBlock Style="{StaticResource HelpNote}" Text="{Binding Note}"
                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Style="{StaticResource HelpRow}">
                                                <TextBlock Style="{StaticResource HelpKey}" Text="{Binding Key}"/>
                                                <TextBlock Style="{StaticResource HelpDesc}" Text="{Binding Desc}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
