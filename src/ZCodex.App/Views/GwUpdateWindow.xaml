<Window x:Class="ZCodex.App.Views.GwUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Msg.GwUpdateTitle}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <CheckBox x:Name="IgnoreBox" Content="{DynamicResource S.Msg.GwUpdateIgnore}"
                  FontSize="12" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource S.Common.Yes}" Width="80" Padding="8,4" Margin="0,0,8,0"
                    IsDefault="True" Click="Yes_Click"/>
            <Button Content="{DynamicResource S.Common.No}" Width="80" Padding="8,4" IsCancel="True"
                    Click="No_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
