<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Palette CLAIRE — valeurs historiques de l'app (thème d'origine).
         Chaque clé doit exister À L'IDENTIQUE dans Theme.Dark.xaml : les deux
         dictionnaires sont interchangeables à chaud (ThemeManager.Apply).
         Les couleurs sémantiques FIXES (or élite #FFD700, rouges d'erreur,
         couleurs de campagne, palette des cadenas) restent en dur dans les vues.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Fonds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"   Color="#F0F0F0"/>
    <SolidColorBrush x:Key="DialogBackgroundBrush"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush"    Color="#F5F5F5"/>
    <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush"   Color="#ECECEC"/>
    <SolidColorBrush x:Key="TabStripBackgroundBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="InsetBackgroundBrush"    Color="#F7F9FB"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush"  Color="#DDDDDD"/>
    <SolidColorBrush x:Key="SlotBackgroundBrush"     Color="#DCDCDC"/>

    <!-- Bordures -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="BorderLightBrush"  Color="#DDDDDD"/>
    <SolidColorBrush x:Key="SlotBorderBrush"   Color="#AAAAAA"/>

    <!-- Textes -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#000000"/>
    <SolidColorBrush x:Key="TextHeadingBrush"   Color="#333333"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555555"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#888888"/>
    <SolidColorBrush x:Key="TextFaintBrush"     Color="#AAAAAA"/>
    <SolidColorBrush x:Key="IconMutedBrush"     Color="#BBBBBB"/>
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="#222222"/>

    <!-- Accent / survol -->
    <SolidColorBrush x:Key="AccentBrush"          Color="#3399FF"/>
    <SolidColorBrush x:Key="AccentDarkBrush"      Color="#2277DD"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#DDE8F0"/>
    <SolidColorBrush x:Key="HoverBorderBrush"     Color="#7BAFD4"/>

    <!-- États -->
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF8E1"/>
    <SolidColorBrush x:Key="WarningBorderBrush"     Color="#F0C040"/>
    <SolidColorBrush x:Key="ErrorTextBrush"         Color="#DD2222"/>
    <SolidColorBrush x:Key="StatHpBrush"            Color="#CC2222"/>
    <SolidColorBrush x:Key="StatEnergyBrush"        Color="#2255CC"/>
    <SolidColorBrush x:Key="StatPipsBrush"          Color="#336644"/>
    <SolidColorBrush x:Key="SkillVariableBrush"     Color="#1A7F37"/>
    <SolidColorBrush x:Key="FluxVariableBrush"      Color="#5865F2"/>
    <SolidColorBrush x:Key="SummonVariableBrush"    Color="#0A7EA4"/>
    <SolidColorBrush x:Key="RitualVariableBrush"    Color="#B7791F"/>
    <SolidColorBrush x:Key="SkillBoostVariableBrush" Color="#7C3AED"/>

    <!-- Chrome des contrôles natifs (Themes/Controls.xaml) -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush"        Color="#E1E1E1"/>
    <SolidColorBrush x:Key="ButtonBorderBrush"            Color="#ADADAD"/>
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush"   Color="#E5F1FB"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush"       Color="#0078D7"/>
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#CCE4F7"/>
    <SolidColorBrush x:Key="ScrollTrackBrush"             Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"             Color="#CDCDCD"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush"        Color="#A6A6A6"/>
    <SolidColorBrush x:Key="MenuPopupBackgroundBrush"     Color="#F0F0F0"/>
    <SolidColorBrush x:Key="MenuHighlightBrush"           Color="#DDE8F0"/>
    <SolidColorBrush x:Key="TooltipBackgroundBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TooltipBorderBrush"           Color="#CCCCCC"/>

</ResourceDictionary>
