<?xml version="1.0" encoding="utf-8"?>
<!--
  Profil de publication destiné à l'INSTALLATEUR.

  Autonome (SelfContained) : le .NET 8 Desktop Runtime est embarqué, le poste cible n'a rien
  à installer au préalable. C'est plus lourd (~150 Mo de sortie) qu'une publication
  « runtime-dependent » (~5 Mo), mais celle-ci obligerait chaque joueur à télécharger et
  installer le runtime avant de pouvoir lancer Z-Codex — friction rédhibitoire pour un outil
  distribué à une communauté de joueurs.

  PublishSingleFile est laissé à false : l'installateur empaquette de toute façon un dossier,
  et le mode fichier unique complique l'extraction des natifs SQLite.
  PublishTrimmed est laissé à false : le trimming casse la réflexion d'EF Core et la
  résolution des ResourceDictionary WPF (thèmes, Strings.fr/en).

  Usage :
    dotnet publish src\ZCodex.App -c Release -p:PublishProfile=win-x64-selfcontained
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Les ressources satellites des dépendances (localisations d'EF Core…) ne servent pas :
         l'UI de Z-Codex gère elle-même FR/EN via ses ResourceDictionary. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
